{
  "name": "campus-cli",
  "version": "3.0.0",
  "description": "Cliente CLI y puente MCP del relay de Campus: cursos, tareas, notas y materiales con el acceso de tu cuenta.",
  "mcpName": "io.github.alejooroncoy/campus-cli",
  "main": "run.js",
  "exports": {
    ".": "./run.js"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/relay",
    "dist/mcp/server.js",
    "dist/mcp/server.d.ts",
    "dist/security/files.js",
    "dist/security/files.d.ts",
    "dist/security/urls.js",
    "dist/security/urls.d.ts",
    "run.js",
    "scripts/mendeley-connect.cjs",
    "README.md",
    "docs/relay-client.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "bin": {
    "campus": "run.js",
    "campus-cli": "run.js",
    "blackboard": "run.js",
    "blackboard-upc": "run.js",
    "campus-mendeley-connect": "scripts/mendeley-connect.cjs"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "prepublishOnly": "npm run build",
    "test": "tsx --test tests/**/*.test.ts",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js"
  },
  "keywords": [
    "campus",
    "campus-cli",
    "campuscli",
    "blackboard",
    "canvas",
    "moodle",
    "upc",
    "aula-virtual",
    "cli",
    "mcp",
    "model-context-protocol",
    "claude",
    "chatgpt",
    "lms",
    "peru"
  ],
  "author": "Alejandro Oroncoy",
  "homepage": "https://campuscli.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alejooroncoy/campus-cli.git"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "playwright": "^1.62.1",
    "proper-lockfile": "4.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/proper-lockfile": "4.1.4",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "axios": "^1.7.0",
    "entities": "^8.1.0",
    "fflate": "^0.8.3",
    "form-data": "^4.0.5",
    "inquirer": "^14.2.0",
    "ipaddr.js": "^2.5.0",
    "ora": "^9.4.1",
    "pdfjs-dist": "^6.3.289",
    "parse5": "8.0.0"
  },
  "engines": {
    "node": ">=22.13.0 || >=24"
  }
}
