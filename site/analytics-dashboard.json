  "url": "https://us.posthog.com/project/539784/dashboard/2219861",
  "status": "instrumentation_deployed",
  "insights": [
    {
      "name": "De la landing a una respuesta",
      "description": "Usuarios que ven la landing, entran a la app, cargan su sesión y completan una consulta en 24 horas. La última etapa se confirma en el servidor.",
      "query": {
        "kind": "FunnelsQuery",
        "dateRange": {
          "date_from": "-30d"
        },
        "properties": [
          {
            "key": "environment",
            "type": "event",
            "operator": "exact",
            "value": "production"
          }
        ],
        "filterTestAccounts": true,
        "funnelsFilter": {
          "funnelOrderType": "ordered",
          "funnelWindowInterval": 1,
          "funnelWindowIntervalUnit": "day",
          "funnelVizType": "steps"
        },
        "series": [
          {
            "kind": "EventsNode",
            "event": "campus_page_viewed",
            "custom_name": "Landing",
            "properties": [
              {
                "key": "page",
                "type": "event",
                "operator": "exact",
                "value": "home"
              }
            ]
          },
          {
            "kind": "EventsNode",
            "event": "campus_cta_clicked",
            "custom_name": "Entrar a la app",
            "properties": [
              {
                "key": "target",
                "type": "event",
                "operator": "exact",
                "value": "app"
              }
            ]
          },
          {
            "kind": "EventsNode",
            "event": "campus_session_ready",
            "custom_name": "App lista",
            "properties": []
          },
          {
            "kind": "EventsNode",
            "event": "campus_api_completed",
            "custom_name": "Respuesta completada",
            "properties": [
              {
                "key": "operation",
                "type": "event",
                "operator": "exact",
                "value": "question"
              },
              {
                "key": "outcome",
                "type": "event",
                "operator": "exact",
                "value": "success"
              }
            ]
          }
        ]
      }
    },
