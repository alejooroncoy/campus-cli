# Public project token (never use a personal PostHog API key).
PUBLIC_POSTHOG_KEY=
# Production events use the same-origin /c-events proxy configured in vercel.json.
# Development and localhost do not send events to PostHog.

# Variables privadas de la función de registro. La clave cifra datos de la hoja.
CAMPUS_COMPLAINTS_DATABASE_URL=
CAMPUS_COMPLAINTS_ENCRYPTION_KEY=
CAMPUS_COMPLAINTS_NOTIFY_TO=info@campuscli.com
CAMPUS_COMPLAINTS_NOTIFY_FROM=
RESEND_API_KEY=
