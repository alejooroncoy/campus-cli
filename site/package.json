{
  "name": "campuscli-site",
  "private": true,
  "type": "module",
  "scripts": {
    "css": "esbuild public/styles.css --minify --outfile=public/styles.min.css --allow-overwrite",
    "dev": "npm run css && astro dev",
    "build": "npm run css && astro build && node scripts/externalize-app-scripts.mjs",
    "check": "astro check",
    "preview": "astro preview",
    "test:agent-discovery": "node scripts/verify-agent-discovery.mjs",
    "test:offline": "node scripts/verify-offline-shell.mjs",
    "test:app": "node scripts/verify-session-cache.mjs && node scripts/verify-conversation-cache.mjs && node scripts/verify-offline-shell.mjs && node scripts/externalize-app-scripts.test.mjs && node scripts/verify-miupc-reconnect.mjs",
    "test:miupc-reconnect": "node scripts/miupc-reconnect-e2e.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.116",
    "@astrojs/react": "^7.0.0",
    "@astrojs/sitemap": "^3.7.3",
    "ai": "^7.0.113",
    "astro": "^7.3.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  }
}
