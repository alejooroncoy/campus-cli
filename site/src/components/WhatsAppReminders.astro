    top: 3px;
    left: 3px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--app-paper);
    box-shadow: 0 1px 2px rgba(16, 42, 58, .25);
    transition: transform .2s cubic-bezier(.16, 1, .3, 1);
  }
  .wa-card__switch input:checked {
    background: var(--app-green);
  }
  .wa-card__switch input:checked::after {
    transform: translateX(16px);
  }
  .wa-card__switch input:disabled {
    opacity: .5;
    cursor: wait;
  }
  .wa-card__switch input:focus-visible,
  .wa-card__consent input:focus-visible,
  .wa-card__extra summary:focus-visible {
    outline: 3px solid var(--app-accent);
    outline-offset: 3px;
  }
  .wa-card__extra {
    border-top: 1px solid var(--app-line);
    padding-top: 12px;
  }
  .wa-card__extra summary {
    cursor: pointer;
    font-size: 13px;
    font-weight: 600;
    color: var(--app-link);
    min-height: 28px;
    display: flex;
    align-items: center;
  }
  .wa-card__extra form {
    display: grid;
    gap: 12px;
    justify-items: start;
    padding-top: 8px;
    font-size: 14px;
    line-height: 1.55;
  }
  .wa-card__consent {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 13px;
    line-height: 1.5;
  }
  .wa-card__consent input {
    accent-color: var(--app-link);
    width: 18px;
    height: 18px;
    flex: none;
    margin: 1px 0 0;
  }
  .wa-card__preview {
    margin: 0;
    display: grid;
    gap: 8px;
  }
  .wa-card__preview figcaption {
    font-size: 12px;
    color: var(--app-muted);
    text-align: center;
  }
  .wa-chat {
    padding: 18px 14px;
    border-radius: 14px;
    background: #efeae2;
  }
  .wa-chat__bubble {
    position: relative;
    padding: 9px 11px 0;
    border-radius: 2px 10px 10px 10px;
    background: #ffffff;
    color: #111b21;
    font-size: 13px;
    line-height: 1.45;
    box-shadow: 0 1px 1px rgba(11, 20, 26, .13);
  }
  .wa-chat__meta {
    display: block;
    font-size: 11px;
    line-height: 1.4;
    color: #667781;
    padding: 6px 0 9px;
  }
  .wa-chat__button {
    display: block;
    margin: 0 -11px;
    padding: 9px;
    border-top: 1px solid #e9edef;
    text-align: center;
    font-weight: 600;
    color: #027eb5;
  }
  @media (max-width: 720px) {
    .wa-card {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .wa-card__step .app-button {
      width: 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wa-card__switch input,
    .wa-card__switch input::after {
      transition: none;
    }
  }
</style>
<script src="../scripts/whatsapp-reminders.ts"></script>
