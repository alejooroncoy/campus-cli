---
interface Props {
  active: "profes" | "copilot" | "perfil" | "turnitin";
}

const { active } = Astro.props;

const nav = [
  { id: "profes", label: "Asistente", href: "/app/profes/", icon: "users" },
  { id: "copilot", label: "Conectar IA", href: "/app/copilot/", icon: "sparkles" },
  { id: "turnitin", label: "Turnitin", href: "/app/turnitin/", icon: "file-text" },
  { id: "perfil", label: "Mi perfil", href: "/app/perfil/", icon: "user" },
];
---

<aside class:list={["shadcn-sidebar", { "sidebar--profes": active === "profes" }]} aria-label="Navegación principal">
  <!-- Sidebar Header -->
  <div class="sidebar-header">
    <a class="sidebar-brand" href="/app/" aria-label="Campus, abrir asistente">
      <div class="sidebar-brand__logo">
        <img src="/assets/campus-logo.webp" width="22" height="22" alt="" />
      </div>
      <div class="sidebar-brand__text">
        <strong class="sidebar-brand__name">Campus</strong>
        <span class="sidebar-brand__sub">UPC · Estudiantes</span>
      </div>
    </a>
  </div>

  {active === "profes" && <div id="profes-sidebar-actions"></div>}

  <!-- Sidebar Content -->
  <div class="sidebar-content">
    <div class="sidebar-group">
      <span class="sidebar-group__label">Plataforma</span>
      <nav class="sidebar-menu" aria-label="Plataforma">
        {nav.map((item) => (
          <a
            href={item.href}
            class:list={["sidebar-menu-btn", { "is-active": active === item.id }]}
            aria-current={active === item.id ? "page" : undefined}
          >
            <svg viewBox="0 0 24 24" class="sidebar-menu-icon" aria-hidden="true">
              <use href={`/assets/lucide.svg?v=3#${item.icon}`} />
            </svg>
            <span>{item.label}</span>
          </a>
        ))}
      </nav>
    </div>

    {active === "profes" && <div id="profes-sidebar-history"></div>}

    <div class="sidebar-group">
      <span class="sidebar-group__label">Ayuda & Conexión</span>
      <nav class="sidebar-menu" aria-label="Ayuda y soporte">
        <a href="/blackboard-mcp/" class="sidebar-menu-btn">
          <svg viewBox="0 0 24 24" class="sidebar-menu-icon" aria-hidden="true">
            <path d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
          </svg>
          <span>Guía de conexión</span>
          <span class="sidebar-badge-ext" aria-hidden="true">↗</span>
        </a>
        <a
          href="https://wa.me/51946189585"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Soporte por WhatsApp al 946 189 585 (se abre en otra pestaña)"
          class="sidebar-menu-btn"
        >
          <svg viewBox="0 0 24 24" class="sidebar-menu-icon" aria-hidden="true">
            <use href="/assets/lucide.svg#message-circle" />
          </svg>
          <span>Soporte por WhatsApp</span>
        </a>
      </nav>
    </div>
  </div>

  <!-- Sidebar Footer -->
  <div class="sidebar-footer sidebar-footer--guest" data-app-sidebar-footer>
    <div class="sidebar-plan-card" data-app-plan-card hidden>
      <strong class="sidebar-plan-title" data-app-plan-card-title>Campus</strong>
      <span class="sidebar-plan-description" data-app-plan-card-desc>Consultas disponibles</span>
      <a href="/app/perfil/" class="sidebar-plan-action" data-app-plan-card-btn>
        <span>Ver mi plan</span>
        <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    <p class="sidebar-guest-note" data-app-sidebar-guest-note>Prueba Campus con 5 consultas.</p>

    <!-- NavUser Dropdown Container -->
    <div class="sidebar-user-container">
      <!-- Popover Menu -->
      <div class="sidebar-dropdown" id="app-sidebar-user-menu" role="menu" hidden>
        <div class="sidebar-dropdown__header">
          <div class="sidebar-dropdown__avatar" data-app-sidebar-menu-avatar>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="8" r="3.2" />
              <path d="M5.5 19a6.5 6.5 0 0 1 13 0" />
            </svg>
          </div>
          <div class="sidebar-dropdown__user-info">
            <strong class="sidebar-dropdown__name" data-app-sidebar-menu-name>Tu cuenta Campus</strong>
            <span class="sidebar-dropdown__sub" data-app-sidebar-menu-sub>Guarda tus consultas</span>
          </div>
        </div>

        <div class="sidebar-dropdown__separator" data-app-sidebar-auth-only hidden></div>

        <a href="/app/perfil/" class="sidebar-dropdown__item" role="menuitem" data-app-sidebar-auth-only hidden>
          <svg viewBox="0 0 24 24" class="sidebar-dropdown__icon" aria-hidden="true">
            <circle cx="12" cy="8" r="3.2" />
            <path d="M5.5 19a6.5 6.5 0 0 1 13 0" />
          </svg>
          <span>Ver mi perfil</span>
        </a>

        <a href="/app/perfil/" class="sidebar-dropdown__item" role="menuitem" data-app-sidebar-auth-only hidden>
          <svg viewBox="0 0 24 24" class="sidebar-dropdown__icon sidebar-dropdown__icon--accent" aria-hidden="true">
            <use href="/assets/lucide.svg#sparkles" />
          </svg>
          <span data-app-sidebar-upgrade-label>Ver mi plan</span>
        </a>

        <div class="sidebar-dropdown__separator" data-app-sidebar-auth-only hidden></div>

        <button type="button" class="sidebar-dropdown__item sidebar-dropdown__item--danger" id="app-sidebar-logout-btn" role="menuitem" data-app-sidebar-logout hidden>
          <svg viewBox="0 0 24 24" class="sidebar-dropdown__icon" aria-hidden="true">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
            <polyline points="16 17 21 12 16 7" />
            <line x1="21" y1="12" x2="9" y2="12" />
          </svg>
          <span>Cerrar sesión</span>
        </button>

        <a href="/api/app/auth/start" class="sidebar-dropdown__item sidebar-dropdown__item--login" id="app-sidebar-login-btn" role="menuitem" data-app-sidebar-login>
          <svg viewBox="0 0 24 24" class="sidebar-dropdown__icon" aria-hidden="true">
            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
            <polyline points="10 17 15 12 10 7" />
            <line x1="15" y1="12" x2="3" y2="12" />
          </svg>
          <span>Iniciar sesión</span>
        </a>
      </div>

      <!-- Trigger Button -->
      <button
        type="button"
        class="sidebar-user"
        id="app-sidebar-user-trigger"
        aria-haspopup="menu"
        aria-expanded="false"
        aria-controls="app-sidebar-user-menu"
        aria-label="Menú de usuario"
      >
        <div class="sidebar-user__avatar" data-app-sidebar-user-avatar>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="8" r="3.2" />
            <path d="M5.5 19a6.5 6.5 0 0 1 13 0" />
          </svg>
        </div>
        <div class="sidebar-user__info">
          <span class="sidebar-user__name" data-app-sidebar-user-name>Mi perfil</span>
          <span class="sidebar-user__sub" data-app-sidebar-user-sub>Conoce Campus</span>
        </div>
        <svg class="sidebar-user__chevron" viewBox="0 0 24 24" aria-hidden="true">
          <path d="m7 15 5 5 5-5M7 9l5-5 5 5" />
        </svg>
      </button>
    </div>
  </div>
</aside>

<style>
  .shadcn-sidebar {
    position: fixed;
    z-index: 90;
    inset: 0 auto 0 0;
    width: 240px;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    padding: 0;
    border-right: 1px solid var(--app-line);
    background: var(--app-paper);
    box-sizing: border-box;
    font-family: inherit;
  }

  /* Header */
  .sidebar-header {
    padding: 14px 14px 12px;
    border-bottom: 1px solid var(--app-line);
  }
  .sidebar-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--app-ink);
  }
  .sidebar-brand__logo {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--app-paper);
    box-shadow: 0 1px 3px rgba(16, 42, 58, .08), 0 1px 2px rgba(16, 42, 58, .08);
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }
  .sidebar-brand__logo img {
    width: 22px;
    height: 22px;
    object-fit: contain;
  }
  .sidebar-brand__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .sidebar-brand__name {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--app-ink);
  }
  .sidebar-brand__sub {
    font-size: 11px;
    color: var(--app-muted);
    line-height: 1.2;
    margin-top: 1px;
  }

  /* Content */
  .sidebar-content {
    flex: 1;
    overflow-y: auto;
    padding: 12px 10px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .sidebar-group {
    display: flex;
    flex-direction: column;
  }
  .sidebar-group__label {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--app-muted);
    padding: 4px 8px 6px;
  }
  .sidebar-menu {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .sidebar-menu-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    min-height: 36px;
    border-radius: 8px;
    color: var(--app-ink);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
    box-sizing: border-box;
  }
  .sidebar-menu-btn:hover {
    background: var(--app-sky-pale);
    color: var(--app-ink);
  }
  .sidebar-menu-btn.is-active {
    background: rgba(23, 182, 231, 0.12);
    color: var(--app-link);
    font-weight: 600;
  }
  .sidebar-menu-icon {
    width: 18px;
    height: 18px;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.8;
    flex-shrink: 0;
  }
  .sidebar-menu-icon--wa {
    color: var(--app-green);
  }
  .sidebar-badge-ext {
    margin-left: auto;
    font-size: 11px;
    color: var(--app-muted);
  }
  .sidebar-dot-online {
    margin-left: auto;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--app-green);
    box-shadow: 0 0 6px rgba(37, 211, 102, 0.5);
  }

  /* Footer */
  .sidebar-footer {
    margin-top: auto;
    padding: 12px 10px 14px;
    border-top: 1px solid var(--app-line);
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: var(--app-canvas);
  }

  .sidebar-footer.sidebar-footer--guest {
    background: var(--app-paper);
  }
  .sidebar-guest-note {
    padding: 0 8px;
    margin: 0;
    color: var(--app-muted);
    font-size: 12px;
    line-height: 1.4;
  }

  /* Compact plan summary */
  .sidebar-plan-card {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 8px;
    min-width: 0;
  }
  .sidebar-plan-title {
    color: var(--app-ink);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.3;
  }
  .sidebar-plan-description {
    color: var(--app-muted);
    font-size: 11px;
    line-height: 1.45;
  }
  .sidebar-plan-action {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 6px;
    min-height: 28px;
    color: var(--app-link);
    font-size: 12px;
    font-weight: 500;
    white-space: nowrap;
  }
  .sidebar-plan-action:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* User Dropdown Container */
  .sidebar-user-container {
    position: relative;
    width: 100%;
  }

  /* Dropdown Popover */
  .sidebar-dropdown {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 0;
    right: 0;
    background: var(--app-sky-pale);
    border: 1px solid var(--app-line);
    border-radius: 12px;
    padding: 6px;
    box-shadow: 0 16px 36px rgba(16, 42, 58, .08), 0 2px 8px rgba(16, 42, 58, .08);
    display: flex;
    flex-direction: column;
    gap: 2px;
    z-index: 100;
    animation: dropdownPop 0.15s ease-out;
    box-sizing: border-box;
  }

  @keyframes dropdownPop {
    from {
      opacity: 0;
      transform: translateY(6px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .sidebar-dropdown__header {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 6px 8px 6px;
  }
  .sidebar-dropdown__avatar {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: var(--app-sky-pale);
    border: 1px solid var(--app-line);
    color: var(--app-link);
    display: grid;
    place-items: center;
    font-size: 11px;
    font-weight: 700;
    flex-shrink: 0;
  }
  .sidebar-dropdown__avatar svg {
    width: 16px;
    height: 16px;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.8;
  }
  :global(.sidebar-dropdown__avatar.has-initials) {
    background: var(--app-sky-pale) !important;
    border-color: var(--app-line) !important;
    color: var(--app-link) !important;
  }
  .sidebar-dropdown__user-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
  }
  .sidebar-dropdown__name {
    font-size: 12px;
    font-weight: 600;
    color: var(--app-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.2;
  }
  .sidebar-dropdown__sub {
    font-size: 11px;
    color: var(--app-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.2;
    margin-top: 2px;
  }
  .sidebar-dropdown__item.sidebar-dropdown__item--login {
    margin-top: 8px;
    background: var(--app-sky-pale);
    color: var(--app-link);
  }
  .sidebar-dropdown__separator {
    height: 1px;
    background: var(--app-sky-pale);
    margin: 4px -6px;
  }
  .sidebar-dropdown__item {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 8px 10px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 500;
    color: var(--app-ink);
    text-decoration: none;
    background: transparent;
    border: none;
    width: 100%;
    cursor: pointer;
    box-sizing: border-box;
    text-align: left;
    transition: background 0.12s ease, color 0.12s ease;
    font-family: inherit;
  }
  .sidebar-dropdown__item:hover {
    background: var(--app-sky-pale);
    color: var(--app-ink);
  }
  .sidebar-dropdown__icon {
    width: 15px;
    height: 15px;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.8;
    flex-shrink: 0;
  }
  .sidebar-dropdown__icon--accent {
    color: var(--app-link);
  }
  .sidebar-dropdown__item--danger {
    color: var(--app-danger);
  }
  .sidebar-dropdown__item--danger:hover {
    background: rgba(239, 68, 68, 0.12);
    color: var(--app-danger);
  }

  /* NavUser Button */
  .sidebar-user {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 6px 8px;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: background .15s ease, color .15s ease, border-color .15s ease, transform .15s ease;
    border: 1px solid transparent;
    box-sizing: border-box;
    min-height: 46px;
    width: 100%;
    cursor: pointer;
    background: transparent;
    text-align: left;
    font: inherit;
  }
  .sidebar-user:hover,
  .sidebar-user[aria-expanded="true"] {
    background: var(--app-paper);
    border-color: var(--app-line);
  }
  .sidebar-user__avatar {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--app-sky-pale);
    border: 1px solid var(--app-line);
    color: var(--app-link);
    display: grid;
    place-items: center;
    font-size: 11px;
    font-weight: 700;
    flex-shrink: 0;
  }
  .sidebar-user__avatar svg {
    width: 17px;
    height: 17px;
    stroke: currentColor;
    fill: none;
    stroke-width: 1.8;
  }
  :global(.sidebar-user__avatar.has-initials) {
    background: var(--app-sky-pale) !important;
    border-color: var(--app-line) !important;
    color: var(--app-link) !important;
  }
  .sidebar-user__info {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
  }
  .sidebar-user__name {
    font-size: 12px;
    font-weight: 600;
    color: var(--app-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.2;
  }
  .sidebar-user__sub {
    font-size: 11px;
    color: var(--app-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.2;
    margin-top: 2px;
  }
  .sidebar-user__chevron {
    width: 15px;
    height: 15px;
    stroke: var(--app-muted);
    fill: none;
    stroke-width: 1.8;
    flex-shrink: 0;
    margin-left: auto;
  }

  @media (max-width: 1000px) {
    .shadcn-sidebar { width: 190px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar-dropdown { animation: none; }
    .sidebar-plan-action { transition: none; }
  }

  @media (max-width: 700px) {
    .shadcn-sidebar {
      display: none !important;
    }
  }
</style>
