---
/**
 * The shell every page shares: announcement bar, header, footer and the head.
 *
 * Before this, each page carried its own copy. That is how the sub-pages ended
 * up on an older header than the homepage — the fix had been applied four
 * times and missed the fifth. One copy, one place to fix.
 */
import FounderDialog from "../components/FounderDialog.astro";

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogType?: "website" | "article";
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageType?: string;
  ogImageAlt?: string;
  published?: string;
  modified?: string;
  markdownUrl?: string;
  schemas?: unknown[];
}

const {
  title,
  description,
  canonical,
  ogType = "website",
  ogTitle = title,
  ogDescription = description,
  ogImage = "https://campuscli.com/assets/og-default.jpg",
  ogImageType = "image/jpeg",
  ogImageAlt = "Campus",
  published,
  modified,
  markdownUrl,
  schemas = [],
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://api.github.com" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <meta name="campus-founder-api" content="https://mcp.campuscli.com/v1/founders" />
    <meta name="campus-turnstile-site-key" content="0x4AAAAAAEDTvI0vNf8mWxAL" />
    <meta name="theme-color" content="#112633" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="ard" type="application/json" href="/.well-known/ard.json" />
    {markdownUrl && (
      <link rel="alternate" type="text/markdown" href={markdownUrl} title="Versión en Markdown" />
    )}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content="Campus" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}
    {published && <meta property="article:author" content="Campus" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="stylesheet" href="/styles.min.css" />
    <slot name="head" />
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body>
    <header class="shell site-header">
      <a class="brand" href="/" aria-label="Campus, inicio"><img src="/assets/campus-logo.webp" width="160" height="160" alt="" /><span>Campus</span></a>
      <nav aria-label="Principal"><a href="/#incluye">Campus Plus</a><a href="/campus-cli/">Blackboard</a><a href="/profes/">Profes</a><a href="/turnitin/">Turnitin</a><a href="/blog/">Blog</a></nav>
      <div class="site-header__actions">
        <a class="header-github" href="https://github.com/alejooroncoy/campus-cli" target="_blank" rel="noreferrer" aria-label="Ver Campus en GitHub" title="Ver Campus en GitHub"><svg viewBox="0 0 1024 1024" xmlns="http://www.w3.org/2000/svg" width="21" height="21" fill="none" aria-hidden="true" focusable="false"><path fill="#1b1f23" fill-rule="evenodd" d="M512 0C229.12 0 0 229.12 0 512c0 226.56 146.56 417.92 350.08 485.76 25.6 4.48 35.2-10.88 35.2-24.32 0-12.16-.64-52.48-.64-95.36-128.64 23.68-161.92-31.36-172.16-60.16-5.76-14.72-30.72-60.16-52.48-72.32-17.92-9.6-43.52-33.28-.64-33.92 40.32-.64 69.12 37.12 78.72 52.48 46.08 77.44 119.68 55.68 149.12 42.24 4.48-33.28 17.92-55.68 32.64-68.48-113.92-12.8-232.96-56.96-232.96-252.8 0-55.68 19.84-101.76 52.48-137.6-5.12-12.8-23.04-65.28 5.12-135.68 0 0 42.88-13.44 140.8 52.48 40.96-11.52 84.48-17.28 128-17.28s87.04 5.76 128 17.28c97.92-66.56 140.8-52.48 140.8-52.48 28.16 70.4 10.24 122.88 5.12 135.68 32.64 35.84 52.48 81.28 52.48 137.6 0 196.48-119.68 240-233.6 252.8 18.56 16 34.56 46.72 34.56 94.72 0 68.48-.64 123.52-.64 140.8 0 13.44 9.6 29.44 35.2 24.32C877.44 929.92 1024 737.92 1024 512 1024 229.12 794.88 0 512 0" clip-rule="evenodd"/></svg><span class="header-github__stars" data-github-stars hidden></span><span class="visually-hidden">GitHub</span></a>
      </div>
    </header>
    <slot />
    <FounderDialog />
    <footer class="footer"><div class="shell footer__inner"><div class="footer__brand"><a class="brand" href="/"><img src="/assets/campus-logo.webp" width="160" height="160" loading="lazy" alt="" /><span>Campus</span></a><p>Tu matrícula y tu ciclo, con Campus.</p></div><div class="footer__links"><strong>Explora</strong><a href="/#incluye">Campus Plus</a><a href="/campus-cli/">Blackboard conectado</a><a href="/profes/">Campus Profes</a><a href="/turnitin/">Turnitin en Perú · S/8</a><a href="/blog/">Blog</a></div><div class="footer__links"><strong>Recursos</strong><a href="/blackboard-mcp/">Blackboard MCP</a><a href="/blackboard-cli/">Blackboard CLI</a><a href="/about/">Sobre Campus</a><a href="/contacto/">Contacto</a><a href="https://github.com/alejooroncoy/campus-cli" target="_blank" rel="noreferrer">GitHub ↗</a></div><div class="footer__action"><strong>¿Listo para empezar?</strong><p>Únete a Campus Plus como fundador.</p><a class="button button--small" href="/#incluye">Conocer Campus Plus</a></div><div class="footer__bottom"><small>© 2026 Campus. Proyecto independiente. <a href="/terminos/">Términos</a> · <a href="/privacidad/">Privacidad</a></small><small><a href="/no-afiliacion/">Campus no está afiliado a UPC, Blackboard, OpenAI ni Anthropic.</a></small></div></div></footer>
    <script src="/app.js" defer></script>
  </body>
</html>
