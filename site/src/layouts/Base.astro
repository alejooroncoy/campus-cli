---
import { turnitinServiceEnabled, libraryServiceEnabled } from "../../feature-flags.mjs";
import Analytics from "../components/Analytics.astro";
import WhatsAppSupport from "../components/WhatsAppSupport.astro";
/**
 * The shell every page shares: announcement bar, header, footer and the head.
 *
 * Before this, each page carried its own copy. That is how the sub-pages ended
 * up on an older header than the homepage — the fix had been applied four
 * times and missed the fifth. One copy, one place to fix.
 */

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogType?: "website" | "article";
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageType?: string;
  ogImageAlt?: string;
  published?: string;
  modified?: string;
  markdownUrl?: string;
  schemas?: unknown[];
  robots?: string;
  keywords?: string[];
  headerAction?: { label: string; href: string };
}

const {
  title,
  description,
  canonical,
  ogType = "website",
  ogTitle = title,
  ogDescription = description,
  ogImage = "https://campuscli.com/assets/og-default.jpg",
  ogImageType = "image/jpeg",
  ogImageAlt = "Campus",
  published,
  modified,
  markdownUrl,
  schemas = [],
  headerAction = { label: "Conectar IA", href: "/app/copilot/" },
  robots = "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1",
  keywords,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords?.length ? <meta name="keywords" content={keywords.join(", ")} /> : null}
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#112633" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="ard" type="application/json" href="/.well-known/ard.json" />
    {markdownUrl && (
      <link rel="alternate" type="text/markdown" href={markdownUrl} title="Versión en Markdown" />
    )}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content="Campus" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}
    {published && <meta property="article:author" content="Campus" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="stylesheet" href="/styles.min.css" />
    <slot name="head" />
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body>
    <a class="site-skip-link" href="#campus-content">Saltar al contenido</a>
    <aside class="site-community" aria-label="Comunidad de Campus">
      <a href="https://chat.whatsapp.com/Hs5SpTt5VAjEzAw8rc5mW4" target="_blank" rel="noopener noreferrer" aria-label="Únete a la comunidad de Campus en WhatsApp (se abre en otra pestaña)">Únete a la comunidad de Campus en WhatsApp</a>
    </aside>
    <header class="shell site-header">
      <a class="brand" href="/" aria-label="Campus, inicio"><img src="/assets/campus-logo.webp" width="160" height="160" alt="" /><span>Campus</span></a>
      <nav aria-label="Principal"><a href="/#incluye">Qué ofrece</a><a href="/#planes">Planes</a><a class="site-nav__expanded-link" href="/profes/">Profesores</a>{libraryServiceEnabled && <a class="site-nav__expanded-link" href="/biblioteca/">Biblioteca</a>}<a class="site-nav__expanded-link" href="/app/copilot/">Campus con IA</a>{turnitinServiceEnabled && <a class="site-nav__expanded-link" href="/turnitin/">Turnitin</a>}</nav>
      <div class="site-header__actions">
        <a class="button button--small" href={headerAction.href}>{headerAction.label} <svg class="cp-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><use href="/assets/lucide.svg#arrow-right"></use></svg></a>
        <details class="site-menu">
          <summary aria-label="Más opciones de Campus"><span>Más</span><svg class="site-menu__chevron" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg><svg class="site-menu__mobile-icon" viewBox="0 0 24 24" width="21" height="21" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16" /></svg></summary>
          <div class="site-menu__panel">
            <a href="/app/asistente/">Preguntar al asistente</a>
            <a class="site-menu__mobile-link" href="/#incluye">Qué ofrece Campus</a>
            <a class="site-menu__mobile-link" href="/#planes">Planes y precios</a>
            <a class="site-menu__secondary-link" href="/profes/">Profesores</a>
            {libraryServiceEnabled && <a class="site-menu__secondary-link" href="/biblioteca/">Biblioteca</a>}
            <a class="site-menu__secondary-link" href="/app/copilot/">Campus con IA</a>
            {turnitinServiceEnabled && <a class="site-menu__secondary-link" href="/turnitin/">Turnitin</a>}
            <a href="/blackboard-upc/">Blackboard UPC: tareas y notas</a>
            <a href="/blog/">Guías y recursos</a>
            <a class="site-menu__help" href="https://wa.me/51946189585" target="_blank" rel="noopener noreferrer" aria-label="Soporte por WhatsApp al +51 946 189 585 (se abre en otra pestaña)">Ayuda por WhatsApp <svg class="site-icon" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><use href="/assets/lucide.svg#arrow-up-right"></use></svg></a>
          </div>
        </details>
      </div>
    </header>
    <div id="campus-content" tabindex="-1"></div>
    <slot />
    <WhatsAppSupport />
    <footer class="footer"><div class="shell footer__inner"><div class="footer__brand"><a class="brand" href="/"><img src="/assets/campus-logo.webp" width="160" height="160" loading="lazy" alt="" /><span>Campus</span></a><p>Tu matrícula y tu ciclo, con Campus.</p><a class="footer__support" id="soporte" href="https://wa.me/51946189585" target="_blank" rel="noopener noreferrer" aria-label="Soporte por WhatsApp al +51 946 189 585 (se abre en otra pestaña)"><svg class="site-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><use href="/assets/lucide.svg#message-circle"></use></svg><span><strong>Soporte por WhatsApp</strong><small>+51 946 189 585</small></span><svg class="site-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><use href="/assets/lucide.svg#arrow-up-right"></use></svg></a></div><div class="footer__links"><strong>Explora</strong><a href="/#planes">Campus Free y Plus</a><a href="/campus-cli/">Blackboard conectado</a><a href="/profes/">Opiniones de profesores</a>
              <a href="/opiniones-campus/">Opiniones sobre Campus</a>{libraryServiceEnabled && <a href="/biblioteca/">Biblioteca de trabajos</a>}{turnitinServiceEnabled && <a href="/turnitin/">Informes IA y similitud · Desde S/9</a>}<a href="/blog/">Blog</a></div><div class="footer__links"><strong>Recursos</strong><a href="https://chat.whatsapp.com/Hs5SpTt5VAjEzAw8rc5mW4" target="_blank" rel="noopener noreferrer" aria-label="Comunidad de Campus en WhatsApp (se abre en otra pestaña)">Comunidad en WhatsApp <svg class="cp-icon" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false"><use href="/assets/lucide.svg#arrow-up-right"></use></svg></a><a href="/blackboard-upc/">Blackboard UPC</a><a href="/blackboard-mcp/">Blackboard MCP</a><a href="/blackboard-cli/">Blackboard CLI</a><a href="/about/">Sobre Campus</a><a href="/contacto/">Contacto</a><a href="https://github.com/alejooroncoy/campus-cli" target="_blank" rel="noreferrer">GitHub <svg class="cp-icon" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false"><use href="/assets/lucide.svg#arrow-up-right"></use></svg></a></div><div class="footer__bottom"><small>© 2026 Campus. Proyecto independiente. <a href="/terminos/">Términos</a> · <a href="/privacidad/">Privacidad</a></small><small><a href="/no-afiliacion/">Campus no está afiliado a UPC, Blackboard, OpenAI ni Anthropic.</a></small></div></div></footer>
    <Analytics />
    <script>
      import "../../public/app.js";
    </script>
  </body>
</html>
