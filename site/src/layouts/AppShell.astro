---
import { turnitinServiceEnabled } from "../../feature-flags.mjs";
import { ClientRouter } from "astro:transitions";
import Analytics from "../components/Analytics.astro";
import AppSidebar from "../components/AppSidebar.astro";

interface Props {
  title: string;
  active: "profes" | "asistente" | "copilot" | "perfil" | "turnitin";
}

const { title, active } = Astro.props;
const isChat = active === "profes" || active === "asistente";
const nav = [
  { id: "asistente", label: "Asistente", href: "/app/asistente/", icon: "users" },
  { id: "copilot", label: "Conectar IA", href: "/app/copilot/", icon: "sparkles" },
  ...(turnitinServiceEnabled ? [{ id: "turnitin", label: "Turnitin", href: "/app/turnitin/", icon: "file-text" }] : []),
  { id: "perfil", label: "Mi perfil", href: "/app/perfil/", icon: "user" },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Campus</title>
    <meta name="description" content="Campus te ayuda a elegir profesores y consultar tu Aula Virtual desde tu asistente. Disponible inicialmente para UPC." />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#f4f8f8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Campus" />
    <link rel="stylesheet" href="/app-dashboard.css?v=22" />
    {isChat && <link rel="stylesheet" href="/profes-chat.css?v=24" />}
    <script is:inline async src="/campus-session-bootstrap.js?v=2"></script>
    {isChat && <script is:inline src="/campus-conversation-bootstrap.js?v=1" data-astro-rerun></script>}
    {/* The mounted chat owns its conversation URLs and browser history. */}
    {!isChat && <ClientRouter />}
  </head>
  <body class="campus-app-body">
    <a class="app-skip" href="#app-content">Saltar al contenido</a>
    <div class="app-shell">
      <AppSidebar active={active} />

      <div class="app-workspace">
        <header class="app-topbar">
          <div class="app-breadcrumb">Campus <span>/</span><strong>{title}</strong></div>
          <a class="app-mobile-brand" href="/app/" aria-label="Campus, abrir asistente">
            <img src="/assets/campus-logo.webp" width="36" height="36" alt="" />
            <span>Campus</span>
          </a>
        </header>

        <div id="app-pwa-banner" class="app-pwa-banner" hidden>
          <div class="app-pwa-banner__content">
            <span class="app-pwa-banner__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><use href="/assets/lucide.svg#sparkles"></use></svg>
            </span>
            <div class="app-pwa-banner__text">
              <strong>Instala Campus</strong>
              <p id="app-pwa-banner-msg">Agrégalo a tu pantalla de inicio para entrar directo al chat.</p>
            </div>
          </div>
          <div class="app-pwa-banner__actions">
            <button type="button" id="app-pwa-install-btn" class="app-button app-button--pwa">Instalar</button>
            <button type="button" id="app-pwa-dismiss-btn" class="app-pwa-banner__close" aria-label="Cerrar invitación">✕</button>
          </div>
        </div>

        <main id="app-content" class:list={["app-main", { "app-main--profes": isChat }]} tabindex="-1">
          <slot />
        </main>
      </div>

      <nav class="app-mobile-nav" aria-label="Campus móvil" transition:persist="app-mobile-nav">
        {nav.map((item) => (
          <a href={item.href} class:list={{ "is-active": active === item.id || (item.id === "asistente" && active === "profes") }} aria-current={active === item.id || (item.id === "asistente" && active === "profes") ? "page" : undefined}>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><use href={`/assets/lucide.svg?v=3#${item.icon}`}></use></svg>
            <span>{item.label}</span>
          </a>
        ))}
      </nav>
    </div>
    <Analytics />
    <script src="../scripts/campus-app.ts"></script>
  </body>
</html>
