---
import Base from "../../layouts/Base.astro";
// Kept as raw html so the markup that is already indexed ships byte for byte.
import body from "../../html/profes/index.html?raw";

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://campuscli.com/profes/#webpage",
    "url": "https://campuscli.com/profes/",
    "name": "Campus | Elige profesores universitarios antes de matricularte",
    "description": "Campus ayuda a estudiantes en Perú a comparar calificaciones, comentarios y horarios de profesores universitarios antes de matricularse.",
    "inLanguage": "es-PE",
    "isPartOf": { "@id": "https://campuscli.com/#website" },
    "mainEntity": { "@id": "https://campuscli.com/profes/#service" },
    "about": ["profesores universitarios", "matrícula universitaria", "horarios de cursos", "reseñas de estudiantes"]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Inicio",
        "item": "https://campuscli.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Campus",
        "item": "https://campuscli.com/profes/"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": "https://campuscli.com/profes/#service",
    "name": "Campus",
    "serviceType": "Comparación de profesores universitarios",
    "areaServed": "PE",
    "url": "https://campuscli.com/profes/",
    "inLanguage": "es-PE",
    "provider": {
      "@type": "Organization",
      "name": "Campus",
      "url": "https://campuscli.com/"
    },
    "description": "La consulta de profesores de Campus ayuda a estudiantes en Perú a comparar calificaciones, comentarios y horarios de profesores antes de matricularse.",
    "audience": { "@type": "EducationalAudience", "educationalRole": "student" },
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "PEN",
      "description": "Campus Free: reseñas, panel y 25 consultas de bienvenida en la web."
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "¿Es lo mismo que Campus para Blackboard?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Las opiniones de profesores son una función de Campus, con el mismo plan que tu asistente web y conector MCP. La conexión a Blackboard te acompaña durante el ciclo con cursos, tareas, notas y anuncios."
        }
      },
      {
        "@type": "Question",
        "name": "¿De dónde salen las calificaciones y comentarios?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "De alumnos que usan Campus: califican después de llevar un curso con ese profesor, y esa información queda disponible para quien pregunte después."
        }
      },
      {
        "@type": "Question",
        "name": "¿Cuesta algo?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Puedes empezar con Campus Free: reseñas, panel y 25 consultas de bienvenida en la web. Campus Plus incluye 100 consultas diarias en la web e ilimitadas por MCP. Consulta los precios y condiciones en los planes de Campus."
        }
      },
      {
        "@type": "Question",
        "name": "¿Cómo evitan reseñas falsas?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Cada calificación queda asociada a quien la escribió y se moderan activamente los reportes de abuso. No se muestran reseñas de cuentas sin actividad real."
        }
      },
      {
        "@type": "Question",
        "name": "¿Qué universidades o profesores tiene?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "El asistente está disponible inicialmente para UPC. Las opiniones dependen de las reseñas disponibles; puedes aportar tu experiencia desde tu cuenta Campus."
        }
      },
      {
        "@type": "Question",
        "name": "¿Puedo buscar profesores de UPC?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sí. Escribe el nombre del curso o del profesor de UPC que buscas y Campus te muestra la información disponible para comparar antes de matricularte."
        }
      }
    ]
  }
];
---

<Base
  title={"Campus | Elige profesores antes de matricularte"}
  description={"Opiniones de profesores en Campus: compara calificaciones y comentarios de estudiantes antes de matricularte."}
  canonical={"https://campuscli.com/profes/"}
  ogTitle={"Campus | Elige a tu profesor desde la web"}
  ogDescription={"Profes, horarios y una matrícula mejor como parte de Campus."}
  markdownUrl={"https://campuscli.com/profes/index.md"}
  ogImageAlt={"Campus: calificaciones y horarios de profesores en la web"}
  schemas={schemas}
>
  <Fragment set:html={body} />
  <link slot="head" rel="stylesheet" href="/campus-profes.css" />
</Base>
