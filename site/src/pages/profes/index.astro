---
import Base from "../../layouts/Base.astro";
// Kept as raw html so the markup that is already indexed ships byte for byte.
import body from "../../html/profes/index.html?raw";

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://campuscli.com/profes/#webpage",
    "url": "https://campuscli.com/profes/",
    "name": "Campus Profes UPC | Opiniones, calificaciones y horarios de profesores",
    "description": "Campus Profes ayuda a estudiantes de UPC a comparar opiniones, calificaciones y horarios de profesores antes de matricularse.",
    "inLanguage": "es-PE",
    "isPartOf": { "@id": "https://campuscli.com/#website" },
    "mainEntity": { "@id": "https://campuscli.com/profes/#service" },
    "about": ["profesores UPC", "opiniones de profesores", "matrícula UPC", "horarios de cursos", "reseñas de estudiantes"]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Inicio",
        "item": "https://campuscli.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Campus Profes",
        "item": "https://campuscli.com/profes/"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": "https://campuscli.com/profes/#service",
    "name": "Campus Profes",
    "serviceType": "Opiniones, calificaciones y horarios de profesores UPC",
    "areaServed": "PE",
    "url": "https://campuscli.com/profes/",
    "inLanguage": "es-PE",
    "provider": {
      "@type": "Organization",
      "name": "Campus",
      "url": "https://campuscli.com/"
    },
    "description": "Campus Profes es parte de Campus Plus y ayuda a estudiantes de UPC a comparar opiniones, calificaciones y horarios de profesores antes de matricularse.",
    "audience": { "@type": "EducationalAudience", "educationalRole": "student" },
    "offers": {
      "@type": "Offer",
      "price": "5",
      "priceCurrency": "PEN",
      "description": "Acceso fundador a Campus Plus por S/5 el primer mes.",
      "availability": "https://schema.org/LimitedAvailability"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "¿Es lo mismo que Campus para Blackboard?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Campus Profes es la parte de Campus Plus para elegir profesores y horarios antes de matricularte. La conexión a Blackboard te acompaña durante el ciclo con cursos, tareas, notas y anuncios."
        }
      },
      {
        "@type": "Question",
        "name": "¿De dónde salen las calificaciones y comentarios?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "De alumnos que usan Campus Profes: califican después de llevar un curso con ese profesor, y esa información queda disponible para quien pregunte después."
        }
      },
      {
        "@type": "Question",
        "name": "¿Cuesta algo?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "El acceso fundador a Campus Plus cuesta S/5 el primer mes. Incluye Campus Profes, horarios y la conexión de Blackboard UPC que ya funciona."
        }
      },
      {
        "@type": "Question",
        "name": "¿Cómo evitan reseñas falsas?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Cada calificación queda asociada a quien la escribió y se moderan activamente los reportes de abuso. No se muestran reseñas de cuentas sin actividad real."
        }
      },
      {
        "@type": "Question",
        "name": "¿Qué universidades o profesores tiene?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "El piloto está abierto a estudiantes en Perú y crece con cada alumno que califica a su profesor."
        }
      },
      {
        "@type": "Question",
        "name": "¿Puedo buscar profesores de UPC?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sí. Escribe el nombre del curso o del profesor de UPC que buscas y Campus Profes te muestra la información disponible para comparar antes de matricularte."
        }
      }
    ]
  }
];
---

<Base
  title={"Campus Profes UPC | Opiniones, calificaciones y horarios"}
  description={"Compara opiniones, calificaciones y horarios de profesores UPC antes de matricularte con Campus Profes."}
  canonical={"https://campuscli.com/profes/"}
  ogTitle={"Campus Profes UPC | Elige mejor a tu profesor"}
  ogDescription={"Opiniones, calificaciones y horarios de profesores UPC antes de matricularte."}
  markdownUrl={"https://campuscli.com/profes/index.md"}
  ogImageAlt={"Campus Profes: calificaciones y horarios de profesores por WhatsApp"}
  schemas={schemas}
>
  <Fragment set:html={body} />
</Base>
