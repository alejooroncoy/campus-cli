---
import {CHARACTER_NAME, renderCharacterName} from '../../lib/character.mjs';

import Base from "../../layouts/Base.astro";
// Shared with the Markdown route so both formats describe the same page.
import rawBody from "../../html/profes/index.html?raw";
import { includeCampusFeedback } from "../../lib/campus-feedback";
const body = renderCharacterName(includeCampusFeedback(rawBody));
const title = "Opiniones de profesores UPC por curso | Campus";
const description = "Consulta opiniones y calificaciones de profesores UPC antes de matricularte. Busca por profesor o curso y revisa las experiencias disponibles.";

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://campuscli.com/profes/#webpage",
    "url": "https://campuscli.com/profes/",
    "name": title,
    "description": description,
    "inLanguage": "es-PE",
    "isPartOf": { "@id": "https://campuscli.com/#website" },
    "mainEntity": { "@id": "https://campuscli.com/profes/#service" },
    "about": ["profesores UPC", "matrícula universitaria", "cursos UPC", "reseñas de estudiantes"]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Inicio",
        "item": "https://campuscli.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Profesores",
        "item": "https://campuscli.com/profes/"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": "https://campuscli.com/profes/#service",
    "name": "Opiniones de profesores UPC",
    "serviceType": "Comparación de profesores universitarios",
    "areaServed": "PE",
    "url": "https://campuscli.com/profes/",
    "inLanguage": "es-PE",
    "provider": {
      "@type": "Organization",
      "name": "Campus",
      "url": "https://campuscli.com/"
    },
    "description": description,
    "audience": { "@type": "EducationalAudience", "educationalRole": "student" },
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "PEN",
      "description": "Campus Free: reseñas, panel y 25 consultas de bienvenida en la web."
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": `¿Quién es ${CHARACTER_NAME}?`,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": `${CHARACTER_NAME} es el agente de Campus. Puedes conversar con él para buscar profesores y consultar las opiniones disponibles de otros estudiantes. Durante el ciclo también puedes usar las funciones de Campus que incluya tu plan.`
        }
      },
      {
        "@type": "Question",
        "name": "¿Puedo buscar profesores de UPC?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sí. Busca por nombre, apellido o curso en el catálogo de profesores UPC. Cada ficha reúne los cursos y las opiniones disponibles."
        }
      },
      {
        "@type": "Question",
        "name": "¿De dónde salen las calificaciones y comentarios?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Las fichas reúnen opiniones compartidas en Campus y las fuentes externas disponibles. Cada opinión indica su origen. Las puntuaciones se muestran en una escala común de 0 a 10; las notas de 1 a 5 se convierten proporcionalmente."
        }
      },
      {
        "@type": "Question",
        "name": "¿Cuesta algo?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Puedes explorar las fichas y leer opiniones desde esta web. Campus Free también incluye acceso al panel y 25 consultas de bienvenida en el asistente. Las consultas de bienvenida no se renuevan cada mes."
        }
      },
      {
        "@type": "Question",
        "name": "¿Cómo evitan reseñas falsas?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Para escribir en Campus necesitas una cuenta y declarar qué curso llevaste. Esto identifica a quien escribe, pero no verifica por sí solo su experiencia. Cada reseña es una opinión personal: lee varias y revisa su fuente antes de elegir."
        }
      },
      {
        "@type": "Question",
        "name": "¿Puedo compartir mi experiencia?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sí. Busca al profesor, entra a su ficha y elige escribir una reseña. Inicia sesión con tu cuenta Campus para compartirla. Tu nombre no se muestra en la reseña."
        }
      },
      {
        "@type": "Question",
        "name": "¿Es lo mismo que Campus para Blackboard?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Es parte de Campus. Aquí puedes explorar opiniones de profesores; con Campus Plus también puedes conectar Blackboard a tu IA para consultar tus cursos, tareas, notas y materiales."
        }
      }
    ]
  }
];
---

<Base
  title={title}
  description={description}
  canonical={"https://campuscli.com/profes/"}
  ogTitle={title}
  ogDescription={description}
  markdownUrl={"https://campuscli.com/profes/index.md"}
  ogImageAlt={"Campus: opiniones de profesores UPC por curso"}
  schemas={schemas}
>
  <Fragment set:html={body} />
  <script src="../../scripts/profes-motion.ts"></script>
  <link slot="head" rel="stylesheet" href="/campus-landing.css" />
  <link slot="head" rel="stylesheet" href="/campus-profes.css" />
  <link slot="head" rel="stylesheet" href="/campus-feedback.css" />
</Base>
