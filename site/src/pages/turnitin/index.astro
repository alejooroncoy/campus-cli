---
import { turnitinServiceEnabled } from "../../../feature-flags.mjs";
if (!turnitinServiceEnabled) return Astro.redirect("/");
import Base from '../../layouts/Base.astro';
import TurnitinLogin from '../../components/TurnitinLogin.astro';
import body from '../../html/turnitin/index.html?raw';
const url = 'https://campuscli.com/turnitin/';
const description = 'Informes de IA o similitud por S/9; ambos por S/14. Gestión de revisión mediante Turnitin API. Paga con Yape o Plin; entrega de 10 min a 1 h tras validar el pago.';
const image = 'https://campuscli.com/assets/og-default.jpg';
const schemas = [
  { '@context': 'https://schema.org', '@type': 'WebPage', '@id': url + '#webpage',
    url, name: 'Informes de IA y similitud desde S/9 | Campus', description,
    inLanguage: 'es-PE', dateModified: '2026-10-26',
    primaryImageOfPage: { '@type': 'ImageObject', url: image, width: 1200, height: 630 },
    mainEntity: { '@id': url + '#service' }, breadcrumb: { '@id': url + '#breadcrumb' } },
  { '@context': 'https://schema.org', '@type': 'Service', '@id': url + '#service',
    name: 'Servicio de Turnitin en Perú con Campus', url, description,
    serviceType: 'Informes de similitud y detección de escritura con IA',
    areaServed: { '@type': 'Country', name: 'Perú', identifier: 'PE' },
    provider: { '@type': 'Organization', '@id': 'https://campuscli.com/#organization',
      name: 'Campus', url: 'https://campuscli.com/' },
    availableChannel: { '@type': 'ServiceChannel', serviceUrl: 'https://campuscli.com/app/turnitin/',
      availableLanguage: 'es' },
    offers: [
      { '@type': 'Offer', name: 'Solo IA', price: '9.00', priceCurrency: 'PEN', url },
      { '@type': 'Offer', name: 'Solo similitud', price: '9.00', priceCurrency: 'PEN', url },
      { '@type': 'Offer', name: 'Similitud + IA', price: '14.00', priceCurrency: 'PEN', url },
    ] },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', '@id': url + '#breadcrumb',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://campuscli.com/' },
      { '@type': 'ListItem', position: 2, name: 'Turnitin Perú', item: url } ] },
];
---
<Base title="Informes de IA y similitud desde S/9 | Campus" description={description}
  headerAction={{ label: "Ir a Turnitin", href: "/app/turnitin/" }}
  canonical={url} markdownUrl={url + 'index.md'} schemas={schemas}
  ogTitle="IA o similitud S/9 · Ambos S/14"
  ogImage={image} ogImageType="image/jpeg"
  ogImageAlt="Campus: IA o similitud por S/9; ambos informes por S/14.">
  <link slot="head" rel="stylesheet" href="/turnitin.css?v=2" />
  <Fragment set:html={body} />
  <TurnitinLogin />
</Base>
