---
import Base from '../../layouts/Base.astro';
import { ucal, ucalFaq } from '../../data/ucal';
import '../../styles/ucal.css';
const icon = (name: string) => `/assets/lucide.svg#${name}`;
const tools = [
  { n: '01', icon: 'users', tag: 'CONOCE UPC', title: 'Elige con más contexto.', description: 'Descubre opiniones de estudiantes sobre profesores UPC. Conoce cómo enseñan y qué experiencias comparten sus alumnos.', label: 'Quiero recibir el aviso', href: '#avisame', note: 'La cobertura depende del profesor y del curso.' },
  { n: '02', icon: 'file-text', tag: 'PARA TUS TRABAJOS', title: 'Llega mejor a tu entrega.', description: 'Revisa citas, referencias y formato APA 7 con las guías de Campus. También puedes calcular tu promedio con notas y créditos.', label: 'Ver herramientas gratuitas', href: '/herramientas/', note: 'Herramientas abiertas, sin conectar tu universidad.' },
  { n: '03', icon: 'book-open', tag: 'CUANDO TENGAS ACCESO UPC', title: 'Tu aula, más a la mano.', description: 'Consulta cursos, tareas, notas y materiales de Blackboard desde una IA compatible, con tu propia cuenta UPC habilitada.', label: 'Avísenme cuando pueda empezar', href: '#avisame', note: 'Requiere una cuenta UPC habilitada y compatible.' },
];
const schemas = [
  { '@context': 'https://schema.org', '@type': 'WebPage', '@id': ucal.url+'#webpage', url: ucal.url, name: ucal.title, description: ucal.description, dateModified: ucal.updated, inLanguage: 'es-PE', isPartOf: {'@id': 'https://campuscli.com/#website'}, citation: [ucal.gestion, ucal.investing, ucal.release] },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Campus', item: 'https://campuscli.com/' }, { '@type': 'ListItem', position: 2, name: 'UCAL y UPC', item: ucal.url }] },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: ucalFaq.map(({q,a}) => ({'@type':'Question', name:q, acceptedAnswer:{'@type':'Answer', text:a}})) },
];
---
<Base title={ucal.title} description={ucal.description} canonical={ucal.url} markdownUrl={`${ucal.url}index.md`} schemas={schemas}
  ogTitle="UPC adquiere UCAL por US$35 millones" ogDescription={ucal.description}
  ogImage="https://campuscli.com/assets/og-ucal.png" ogImageType="image/png" ogImageAlt="UPC adquiere UCAL por US$35 millones. Una guía para estudiantes, por Campus."
  headerAction={{ label: 'Recibir aviso', href: '#avisame' }}>
  <link slot="head" rel="stylesheet" href="/campus-landing.css" />
  <main class="campus-landing ucal-page">
    <div class="ucal-top shell"><a href="/">Campus</a><span aria-hidden="true">/</span><span>Para estudiantes de UCAL</span><a class="ucal-top__jump" href="#integracion">Sobre la integración <svg class="cp-icon" aria-hidden="true"><use href={icon('arrow-down')}></use></svg></a></div>
    <section class="cp-hero shell ucal-hero" aria-labelledby="ucal-title">
      <div class="cp-hero__copy">
        <p class="cp-kicker"><span></span> UCAL → UPC · VAMOS CONTIGO</p>
        <h1 id="ucal-title">UPC adquiere UCAL<br>por <em>US$35 millones.</em></h1>
        <p class="cp-lead">Laureate anunció la compra el 5 de noviembre de 2026. La integración está prevista para el 16 de febrero de 2027.</p>
        <p class="ucal-hero__student">¿Estudias en UCAL? Déjanos un correo que seguirás usando. Te avisaremos cuando puedas empezar en Campus con tu acceso UPC.</p>
        <div class="cp-actions"><a class="button" href="#avisame">Quiero que me avisen <svg class="cp-icon" aria-hidden="true"><use href={icon('arrow-right')}></use></svg></a><a class="cp-link" href="#integracion">Sobre la integración <svg class="cp-icon" aria-hidden="true"><use href={icon('arrow-up-right')}></use></svg></a></div>
        <p class="ucal-hero__note">Sin cuenta UPC por ahora. Confirma tu correo para recibir el aviso.</p>
      </div>
      <aside class="ucal-kit ucal-signup" id="avisame" aria-labelledby="signup-title">
        <div class="ucal-kit__bar"><span><img src="/assets/campus-logo.webp" width="24" height="24" alt="" /> Campus</span><span>PARA ESTUDIANTES UCAL</span></div>
        <div class="ucal-kit__welcome"><img src="/assets/campu-avatar-90.png" width="72" height="72" alt="" /><div><span>TE ACOMPAÑAMOS EN LO QUE VIENE</span><h2 id="signup-title">Te avisamos cuando esté listo.</h2><p>Déjanos tu correo para avisarte.</p></div></div>
        <form class="ucal-form" method="post" action="/api/ucal-waitlist" data-ucal-signup>
          <label class="ucal-form__label" for="ucal-email">Tu correo</label>
          <input id="ucal-email" name="email" type="email" autocomplete="email" inputmode="email" maxlength="254" placeholder="tu@correo.com" required aria-describedby="email-hint" />
          <p class="ucal-form__hint" id="email-hint">Puede ser personal. Elige uno al que seguirás teniendo acceso.</p>
          <div class="ucal-form__trap" aria-hidden="true"><label>Sitio web<input name="website" type="text" tabindex="-1" autocomplete="off" /></label></div>
          <label class="ucal-form__consent"><input name="consent" type="checkbox" required /><span>Quiero que Campus me avise por correo cuando pueda empezar a usarlo con mi acceso UPC. <a href="/privacidad/#avisos-ucal" target="_blank" rel="noopener noreferrer">Cómo se usa mi correo</a>.</span></label>
          <button class="button" type="submit" disabled data-ucal-submit>Avísenme cuando esté listo <svg class="cp-icon" aria-hidden="true"><use href={icon('arrow-right')}></use></svg></button>
          <p class="ucal-form__feedback" role="status" aria-live="polite" data-ucal-status></p>
          <noscript><p class="ucal-form__hint">Activa JavaScript para inscribirte o escribe a info@campuscli.com.</p></noscript>
        </form>
        <div class="ucal-form ucal-form__success" data-ucal-pending hidden><svg class="cp-icon" aria-hidden="true"><use href={icon('check')}></use></svg><h3>Revisa tu correo.</h3><p>Si tu correo aún no está confirmado, recibirás un enlace para completar la inscripción. Si ya lo confirmaste antes, no necesitas repetirlo.</p><button class="cp-link" type="button" data-ucal-retry>Usar otro correo</button></div>
        <div class="ucal-kit__foot">Una confirmación y el aviso que autorizaste. Puedes darte de baja.</div>
      </aside>
    </section>

    <aside class="ucal-context shell" aria-label="Contexto de la integración"><span class="ucal-context__tag">UCAL + UPC</span><p>La integración está prevista para el <strong>16 de febrero de 2027</strong>. Te contamos qué se sabe y cómo prepararte.</p><a href="#integracion">Ver información <svg class="cp-icon" aria-hidden="true"><use href={icon('arrow-down')}></use></svg></a></aside>

    <section class="cp-section shell ucal-tools" id="incluye" aria-labelledby="tools-title">
      <div class="ucal-heading"><div><p class="cp-kicker">MENOS VUELTAS. MÁS TIEMPO PARA TI.</p><h2 id="tools-title">Para las preguntas<br>que vienen contigo.</h2></div><p>Las herramientas de Campus, también para acompañarte a conocer UPC.</p></div>
      <div class="ucal-tools__grid">{tools.map(tool => <article><div class="ucal-tools__top"><svg class="cp-icon" aria-hidden="true"><use href={icon(tool.icon)}></use></svg><span>{tool.n} / {tool.tag}</span></div><h3>{tool.title}</h3><p>{tool.description}</p><a href={tool.href}>{tool.label}<svg class="cp-icon" aria-hidden="true"><use href={icon('arrow-right')}></use></svg></a><small>{tool.note}</small></article>)}</div>
    </section>



    <section class="ucal-integration shell" id="integracion" aria-labelledby="integration-title">
      <div class="ucal-integration__card">
        <div class="ucal-integration__overview">
          <time class="ucal-integration__date" datetime="2027-02-16"><span>FEB</span><strong>16</strong><span>2027</span></time>
          <div><p class="cp-kicker">UCAL → UPC</p><h2 id="integration-title">Tu siguiente etapa en UPC.</h2><p>La integración está prevista para el 16 de febrero de 2027. Mientras llegan los siguientes pasos, puedes explorar las herramientas de Campus.</p></div>
        </div>
        <details class="ucal-integration__more">
          <summary>Sobre la integración y sus fuentes<svg class="cp-icon" aria-hidden="true"><use href={icon('plus')}></use></svg></summary>
          <div class="ucal-integration__body">
            <p>Laureate anunció el 5 de noviembre de 2026 la adquisición de UCAL por parte de UPC por aproximadamente US$35 millones. La fecha prevista de integración figura en el comunicado universitario compartido y en la cobertura de Gestión.</p>
            <p>La universidad comunicará cómo se habilitarán los accesos y las condiciones de cada estudiante. Para conectar tu aula con Campus necesitarás una cuenta UPC habilitada y compatible. <a href="#faq">Ver preguntas frecuentes</a>.</p>
            <div class="ucal-integration__sources"><span>Fuentes</span><a href={ucal.release} target="_blank" rel="noopener noreferrer">Laureate ↗</a><a href={ucal.gestion} target="_blank" rel="noopener noreferrer">Gestión ↗</a><a href={ucal.investing} target="_blank" rel="noopener noreferrer">Investing.com ↗</a></div>
            <p class="ucal-integration__note">Revisado el <time datetime={ucal.updated}>5 de noviembre de 2026</time>. Campus es independiente de UCAL y UPC.</p>
          </div>
        </details>
      </div>
    </section>

    <section class="cp-faq shell" id="faq" aria-labelledby="ucal-faq-title"><div><p class="cp-kicker">TODO CLARO, DESDE EL INICIO</p><h2 id="ucal-faq-title">Antes de empezar.</h2><p class="ucal-faq__intro">Sobre la integración, tu cuenta y lo que Campus puede hacer por ti.</p></div><div class="cp-faq__items">{ucalFaq.map(({q,a}) => <details><summary>{q}<svg class="cp-icon" aria-hidden="true"><use href={icon('plus')}></use></svg></summary><p>{a}</p></details>)}</div></section>

    <section class="ucal-closing cp-final shell"><div><p class="cp-kicker">TU CICLO, CON CAMPUS</p><h2>Hazle espacio<br>a lo que viene.</h2><p>Déjanos tu correo y te avisaremos cuando puedas dar el siguiente paso.</p></div><div><a class="button" href="#avisame">Quiero que me avisen <svg class="cp-icon" aria-hidden="true"><use href={icon('arrow-right')}></use></svg></a><a class="cp-link" href="#avisame">Recibir el aviso de disponibilidad <svg class="cp-icon" aria-hidden="true"><use href={icon('arrow-up-right')}></use></svg></a></div></section>
  </main>
<script src="../../scripts/ucal-waitlist.ts"></script>
</Base>
