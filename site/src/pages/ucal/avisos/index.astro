---
import Base from '../../../layouts/Base.astro';
import '../../../styles/ucal.css';
---
<Base title="Confirma tu aviso de Campus | Campus" description="Confirma tu correo o retira tu inscripción a los avisos de Campus para estudiantes de UCAL." canonical="https://campuscli.com/ucal/avisos/" robots="noindex,nofollow" analytics={false} headerAction={{label:'Volver a UCAL',href:'/ucal/'}}>
  <meta slot="head" name="referrer" content="no-referrer" />
  <main class="ucal-notice shell" data-ucal-notice>
    <p class="cp-kicker">CAMPUS · AVISOS PARA UCAL</p>
    <h1 data-notice-title>Tu aviso de Campus.</h1>
    <p data-notice-description>Abre el enlace de tu correo para confirmar tu inscripción o darte de baja.</p>
    <button class="button" type="button" data-notice-action hidden></button>
    <p role="status" aria-live="polite" data-notice-status></p>
    <noscript><p>Activa JavaScript para confirmar el enlace o escribe a info@campuscli.com.</p></noscript>
    <a href="/ucal/">Volver a la página de UCAL</a>
  </main>
  <script src="../../../scripts/ucal-waitlist.ts"></script>
</Base>
