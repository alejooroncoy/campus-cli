---
import Base from "../../layouts/Base.astro";
import body from "../../html/blackboard-upc/index.html?raw";

const url = "https://campuscli.com/blackboard-upc/";
const title = "Blackboard UPC: acceso, tareas y notas | Campus";
const description = "Entra al Aula Virtual oficial de la UPC y encuentra guías para ver cursos, tareas y notas. Conoce cómo consultarlos con IA en Campus.";

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: "https://campuscli.com/" },
      { "@type": "ListItem", position: 2, name: "Blackboard UPC", item: url },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Campus para Blackboard UPC",
    serviceType: "Conexión de Blackboard UPC con asistentes de IA",
    provider: { "@type": "Organization", name: "Campus", url: "https://campuscli.com/" },
    areaServed: { "@type": "Country", name: "Perú" },
    url,
    description: "Consulta cursos, tareas, notas, anuncios y materiales de Blackboard UPC desde ChatGPT o Claude.",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "¿Cómo ingreso al Aula Virtual de la UPC?",
        acceptedAnswer: { "@type": "Answer", text: "Entra a https://aulavirtual.upc.edu.pe/ e inicia sesión con tu cuenta institucional. Campus es un servicio independiente para consultar tus cursos con IA." },
      },
      {
        "@type": "Question",
        name: "¿Necesito pagar ChatGPT Plus?",
        acceptedAnswer: { "@type": "Answer", text: "Campus Plus incluye el conector alojado. La disponibilidad de conectores en tu asistente de IA depende de su cuenta y plan; una suscripción externa, si se requiere, se paga por separado." },
      },
      {
        "@type": "Question",
        name: "¿Puedo enviar una tarea sin revisarla?",
        acceptedAnswer: { "@type": "Answer", text: "No. Cualquier envío requiere tu confirmación explícita; Campus no entrega trabajos por su cuenta." },
      },
      {
        "@type": "Question",
        name: "¿Campus está afiliado a la UPC o Blackboard?",
        acceptedAnswer: { "@type": "Answer", text: "No. Campus es un proyecto independiente y no está afiliado a UPC ni a Blackboard." },
      },
    ],
  },
];
---

<Base
  title={title}
  description={description}
  canonical={url}
  ogTitle={title}
  ogDescription={description}
  ogImageAlt="Campus para Blackboard UPC"
  markdownUrl={`${url}index.md`}
  schemas={schemas}
>
  <link slot="head" rel="stylesheet" href="/blackboard-upc.css" />
  <Fragment set:html={body} />
</Base>
