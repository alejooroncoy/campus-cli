---
import Base from '../../layouts/Base.astro';
import '../../styles/student-tools.css';

export function getStaticPaths() {
const pages = {
  'promedio-ponderado': { tag: 'CALCULADORA · NOTAS', number: '01', title: 'Tu esfuerzo, en números claros.', headline: 'Calcula tu promedio ponderado', description: 'Ingresa tus notas y créditos para conocer tu promedio. Ve cada paso del cálculo y prueba diferentes escenarios.', label: 'PROMEDIO PONDERADO', source: 'https://explora.upc.edu.pe/como-se-promedia-mi-promedio-ponderado', sourceLabel: 'Cómo calcula el promedio la UPC', detail: 'Multiplicamos cada nota por sus créditos, sumamos los resultados y dividimos entre el total de créditos.', note: 'Es una simulación con los datos que ingresas. Confirma las reglas de tu universidad y tu resultado oficial.' },
  'citar-tesis-apa-7': { tag: 'GUÍA INTERACTIVA · APA 7', number: '02', title: 'Una buena idea merece una buena referencia.', headline: 'Cita una tesis en APA 7', description: 'Ordena los datos de una tesis publicada en un repositorio y obtén una referencia para revisar y copiar.', label: 'REFERENCIAS APA 7', source: 'https://biblioteca.upc.edu.pe/citas-referencias-APA7/tesis', sourceLabel: 'Guía de tesis de la Biblioteca UPC', detail: 'Una tesis publicada suele incluir autor, año, título, tipo de tesis, universidad y repositorio o URL.', note: 'Revisa los datos en la fuente original. Este ejemplo es para una tesis publicada en un repositorio; otros casos tienen reglas diferentes.' },
  'citar-figura-apa-7': { tag: 'GUÍA INTERACTIVA · APA 7', number: '03', title: 'Dale crédito a cada idea visual.', headline: 'Cómo citar una figura en APA 7', description: 'Identifica el origen de tu figura y encuentra una guía clara para presentarla en tu trabajo.', label: 'FIGURAS APA 7', source: 'https://facultad-educacion.pucp.edu.pe/wp-content/uploads/2023/04/Pautas-formales-Trabajos-de-investigacion-ISBN-1.pdf', sourceLabel: 'Ejemplo de figura de la PUCP', detail: 'Incluye el número y título de la figura; si corresponde, explica debajo su procedencia y agrega la referencia.', note: 'La atribución y los permisos dependen de la fuente y el uso. Revisa los requisitos de tu institución.' },
  'estudiar-pdf': { tag: 'ESTUDIO · MATERIALES', number: '04', title: 'Menos vueltas. Más comprensión.', headline: 'Estudia mejor con tus materiales', description: 'Convierte tus lecturas en un plan de estudio: identifica ideas clave, verifica las fuentes y practica con preguntas.', label: 'ESTUDIAR CON PDF', source: 'https://campuscli.com/blackboard-upc/', sourceLabel: 'Conoce cómo Campus conecta con tu aula', detail: 'Empieza con tus materiales de clase, identifica los conceptos que necesitas comprender y vuelve al documento para comprobar cada respuesta.', note: 'La generación automática de resúmenes y preguntas está en exploración. Esta página muestra la idea y cómo estudiar con Campus hoy.' },
  'cursos-verano-electivos': { tag: 'MATRÍCULA · UPC Y UPN', number: '05', title: 'Elige tu próximo paso con claridad.', headline: 'Cursos de verano y electivos', description: 'Ordena lo que necesitas revisar antes de elegir cursos y encuentra los canales oficiales de tu universidad.', label: 'PLANEA TUS CURSOS', source: 'https://explora.upc.edu.pe/', sourceLabel: 'Explora UPC', detail: 'Revisa tu malla, los requisitos y la oferta vigente antes de tomar una decisión. Fechas y condiciones pueden variar por universidad y ciclo.', note: 'Campus es independiente de UPC y UPN. La información oficial de cada institución prevalece.' },
};
return Object.entries(pages).map(([slug, page]) => ({params: {slug}, props: {page, slug}})); }
const {page, slug} = Astro.props;
const canonical = `https://campuscli.com/herramientas/${slug}/`;
---
<Base title={`${page.headline} | Campus`} description={page.description} canonical={canonical}>
<main class="tools-page" data-tool={slug}>
  <div class="tools-wrap">
    <div class="tools-top"><a href="/herramientas/"><svg class="tools-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="/assets/lucide.svg#arrow-left"></use></svg> Todas las herramientas</a><span>HECHO PARA TU CICLO</span></div>
    <section class="tools-hero">
      <div class="tools-intro"><p class="tools-eyebrow"><span></span>{page.tag}</p><h1>{page.headline}<em>.</em></h1><p class="tools-lead">{page.description}</p><div class="tools-promise"><span class="tools-promise-icon"><svg class="tools-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="/assets/lucide.svg#sparkles"></use></svg></span><p><strong>{page.title}</strong><br/>Una cosa menos de la que preocuparte.</p></div><a class="tools-jump" href="#herramienta">Ir a la herramienta <svg class="tools-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="/assets/lucide.svg#arrow-down"></use></svg></a></div>
      <div class="tools-card" id="herramienta"><div class="tools-card-head"><span>{page.label}</span><span class="tools-card-num">{page.number} / 07</span></div>
        {slug === 'promedio-ponderado' && <div data-calculator><h2>Hagamos las cuentas.</h2><p>Agrega la nota final y los créditos de cada curso.</p><div class="calc-labels"><span>CURSO</span><span>NOTA</span><span>CRÉDITOS</span><span></span></div><div data-rows></div><button type="button" class="tools-add" data-add><svg class="tools-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="/assets/lucide.svg#plus"></use></svg> Añadir otro curso</button><button type="button" class="tools-primary" data-calculate>Calcular promedio <svg class="tools-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="/assets/lucide.svg#arrow-right"></use></svg></button><div class="tools-result" data-result aria-live="polite"><small>TU RESULTADO</small><strong>—</strong><span>Completa tus datos para empezar.</span></div><p class="tools-footnote">La información se calcula en tu navegador.</p></div>}
        {slug === 'citar-tesis-apa-7' && <div data-thesis><h2>Empecemos por la fuente.</h2><p>Completa los datos de una tesis publicada en un repositorio.</p><form data-thesis-form><label>Autores <span>Apellido, iniciales; separa cada autor con punto y coma</span><input name="author" placeholder="Ej. García, M.; Pérez, L." required /></label><div class="field-pair"><label>Año<input name="year" inputmode="numeric" placeholder="2024" required /></label><label>Grado<select name="degree" required><option value="" selected disabled>Selecciona el grado</option><option>licenciatura</option><option>maestría</option><option>doctorado</option></select></label></div><label>Título de la tesis<input name="title" placeholder="Escribe el título completo" required /></label><label>Universidad<input name="university" placeholder="Nombre de la universidad" required /></label><label>Repositorio <span>Nombre del repositorio</span><input name="repository" placeholder="Ej. Repositorio institucional" required /></label><label>URL de la tesis<input name="url" type="url" placeholder="https://..." required /></label><button class="tools-primary" type="submit">Crear referencia <svg class="tools-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="/assets/lucide.svg#arrow-right"></use></svg></button></form><div class="citation-output" data-citation hidden aria-live="polite"></div><p class="tools-footnote">Comprueba los datos y el formato antes de entregar. Al copiar, aplica cursiva al título en tu documento.</p></div>}
        {slug === 'citar-figura-apa-7' && <div data-figure><h2>¿De dónde viene tu figura?</h2><p>Elige la opción que describe mejor tu caso.</p><div class="figure-options"><button class="figure-option" data-kind="propia" aria-pressed="true"><span>01</span><strong>La hice yo</strong><small>Figura de elaboración propia</small></button><button class="figure-option" data-kind="tomada" aria-pressed="false"><span>02</span><strong>La tomé de una fuente</strong><small>Sin modificaciones</small></button><button class="figure-option" data-kind="adaptada" aria-pressed="false"><span>03</span><strong>La adapté</strong><small>Modifiqué una figura existente</small></button></div><div class="figure-answer" data-figure-answer aria-live="polite"><small>TU SIGUIENTE PASO</small><strong>Presenta tu figura con número y título.</strong><p>Agrega una nota si se necesita explicar su contenido. Consulta los criterios de tu institución sobre la atribución.</p></div></div>}
        {slug === 'estudiar-pdf' && <div class="study-demo"><span class="demo-tag">UNA FORMA DE ESTUDIAR</span><h2>Tu próxima sesión,<br/>más enfocada.</h2><div class="study-item"><b>01</b><span><strong>Reúne tus materiales</strong><small>Elige los documentos de la semana.</small></span><svg class="tools-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="/assets/lucide.svg#arrow-right"></use></svg></div><div class="study-item"><b>02</b><span><strong>Encuentra las ideas clave</strong><small>Vuelve a la fuente para comprobarlas.</small></span><svg class="tools-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="/assets/lucide.svg#arrow-right"></use></svg></div><div class="study-item"><b>03</b><span><strong>Pon a prueba lo que sabes</strong><small>Formula preguntas y repasa tus dudas.</small></span><svg class="tools-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="/assets/lucide.svg#arrow-right"></use></svg></div><a class="tools-primary" href="/app/">Explorar Campus <svg class="tools-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="/assets/lucide.svg#arrow-right"></use></svg></a><p class="tools-footnote">La generación automática de resúmenes está en exploración.</p></div>}
        {slug === 'cursos-verano-electivos' && <div class="study-demo"><span class="demo-tag">ANTES DE ELEGIR</span><h2>Una buena matrícula empieza aquí.</h2><div class="study-item"><b>01</b><span><strong>Revisa tu malla</strong><small>Identifica cursos y requisitos pendientes.</small></span><svg class="tools-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="/assets/lucide.svg#arrow-right"></use></svg></div><div class="study-item"><b>02</b><span><strong>Consulta la oferta oficial</strong><small>Verifica horarios, fechas y disponibilidad.</small></span><svg class="tools-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="/assets/lucide.svg#arrow-right"></use></svg></div><div class="study-item"><b>03</b><span><strong>Organiza tus opciones</strong><small>Compara alternativas para tu próximo ciclo.</small></span><svg class="tools-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="/assets/lucide.svg#arrow-right"></use></svg></div><a class="tools-primary" href="/app/">Explorar mis cursos <svg class="tools-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="/assets/lucide.svg#arrow-right"></use></svg></a><p class="tools-footnote">Consulta tu universidad para confirmar vacantes y condiciones.</p></div>}
      </div>
    </section>
    <section class="tools-explain"><div><p class="tools-eyebrow"><span></span>UN POCO MÁS DE CONTEXTO</p><h2>Lo importante,<br/><em>sin complicaciones.</em></h2></div><div><p>{page.detail}</p><p>{page.note}</p><a href={page.source} target="_blank" rel="noopener noreferrer">{page.sourceLabel} <svg class="tools-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="/assets/lucide.svg#arrow-up-right"></use></svg></a>{slug === 'cursos-verano-electivos' && <p>Para UPN, consulta <a href="https://www.upn.edu.pe/" target="_blank" rel="noopener noreferrer">UPN <svg class="tools-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="/assets/lucide.svg#arrow-up-right"></use></svg></a> y Mi Mundo UPN para información vigente.</p>}</div></section>
    <section class="tools-bottom"><span>HECHO PARA ESTUDIANTES</span><h2>Tu ciclo tiene muchas partes.<br/><em>Juntémoslas.</em></h2><a href="/app/">Conoce Campus <svg class="tools-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="/assets/lucide.svg#arrow-right"></use></svg></a></section>
  </div>
</main>
<script src="../../scripts/student-tools.ts"></script>
</Base>
