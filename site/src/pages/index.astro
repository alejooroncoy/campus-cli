---
import Base from "../layouts/Base.astro";
// Shared with the Markdown route so public plan details stay consistent.
import body from "../html/index.html?raw";

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": "https://campuscli.com/#organization",
    "name": "Campus",
    "alternateName": [
      "Campus CLI",
      "campus-cli",
      "blackboard-cli"
    ],
    "url": "https://campuscli.com/",
    "logo": "https://campuscli.com/assets/campus-logo.webp",
    "description": "Campus ayuda a estudiantes UPC a consultar profesores, cursos, tareas y notas. Ofrece Campus Free y Campus Plus, con asistente web y conexión con IA.",
    "disambiguatingDescription": "No confundir con el paquete `campus-cli` de PyPI (Python, gestión de notebooks Jupyter) ni con otras plataformas de IA para estudiantes con nombres similares (CampusCode, Campus AI).",
    "sameAs": [
      "https://github.com/alejooroncoy/campus-cli"
    ],
    "areaServed": "PE",
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "customer support",
      "email": "info@campuscli.com",
      "availableLanguage": ["es"]
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Lima",
      "addressCountry": "PE"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": "https://campuscli.com/#website",
    "name": "Campus",
    "url": "https://campuscli.com/",
    "inLanguage": "es-PE",
    "publisher": {
      "@id": "https://campuscli.com/#organization"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Campus",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Asistente de Campus",
        "description": "Consulta profesores, notas actuales y cuánto necesitas para aprobar.",
        "url": "https://campuscli.com/app/profes/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Blackboard conectado",
        "description": "Consulta cursos, tareas, notas y anuncios de Blackboard UPC desde asistentes compatibles.",
        "url": "https://campuscli.com/campus-cli/"
      }
    ]
  },
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Puedo usar Campus gratis?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí. Campus Free cuesta S/0 e incluye 25 consultas de bienvenida al crear tu cuenta para consultar profesores y cursos con el asistente web. Son consultas de bienvenida, no una cuota mensual."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuánto cuesta Campus Plus?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Los primeros 25 usuarios de pago acceden por S/5 el primer mes y luego S/10 al mes. Una vez completado ese grupo, las nuevas suscripciones cuestan S/15 al mes desde el primer mes. La promoción se asigna al activar el pago, no al enviar el formulario."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cómo activo Campus Plus?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Elige “Quiero Campus Plus” y déjanos tus datos. Te escribiremos por WhatsApp para confirmar la tarifa disponible y coordinar el pago y la activación."
      }
    },
    {
      "@type": "Question",
      "name": "¿Puedo usar Campus con mi IA?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí. Puedes conectar Blackboard UPC con asistentes compatibles como ChatGPT, Claude y Gemini. Consulta la guía de conexión. La suscripción a un asistente externo, si la requiere, se contrata por separado."
      }
    },
    {
      "@type": "Question",
      "name": "¿Campus es parte de la UPC?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Campus es un proyecto independiente, hecho por estudiantes. No está afiliado a UPC, Blackboard, OpenAI ni Anthropic. La conexión universitaria está disponible inicialmente para UPC."
      }
    }
  ]
}
];
---

<Base
  title={"Campus | Tu universidad, un poco más fácil"}
  description={"Conoce Campus Free y Campus Plus para UPC. Plus: S/5 el primer mes y luego S/10 al mes para los primeros 25 usuarios de pago. Después, S/15 al mes para nuevos usuarios."}
  canonical={"https://campuscli.com/"}
  markdownUrl={"https://campuscli.com/index.md"}
  ogTitle={"Campus Free y Campus Plus | Tu universidad, más fácil"}
  ogDescription={"Empieza gratis con Campus Free. Campus Plus para los primeros 25 de pago: S/5 el primer mes y luego S/10 al mes. Nuevos usuarios después: S/15 al mes."}
  ogImageAlt={"Campus: matrícula, horarios y Blackboard UPC"}
  schemas={schemas}
>
  <Fragment set:html={body} />
  <link slot="head" rel="stylesheet" href="/campus-landing.css" />
</Base>
