---
import Base from "../layouts/Base.astro";
// Shared with the Markdown route so public plan details stay consistent.
import body from "../html/index.html?raw";

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": "https://campuscli.com/#organization",
    "name": "Campus",
    "alternateName": [
      "Campus CLI",
      "campus-cli",
      "blackboard-cli"
    ],
    "url": "https://campuscli.com/",
    "logo": "https://campuscli.com/assets/campus-logo.webp",
    "description": "Campus ayuda a estudiantes UPC a consultar profesores, cursos, tareas y notas. Ofrece Campus Free y Campus Plus, con asistente web y conexión con IA para consultar Blackboard, analizar transcripciones de clases virtuales, guardar referencias en Mendeley y usar la lectura experimental de fuentes accesibles.",
    "disambiguatingDescription": "No confundir con el paquete `campus-cli` de PyPI (Python, gestión de notebooks Jupyter) ni con otras plataformas de IA para estudiantes con nombres similares (CampusCode, Campus AI).",
    "sameAs": [
      "https://github.com/alejooroncoy/campus-cli"
    ],
    "areaServed": "PE",
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "customer support",
      "email": "info@campuscli.com",
      "availableLanguage": ["es"]
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Lima",
      "addressCountry": "PE"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": "https://campuscli.com/#website",
    "name": "Campus",
    "url": "https://campuscli.com/",
    "inLanguage": "es-PE",
    "publisher": {
      "@id": "https://campuscli.com/#organization"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Campus",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Asistente de Campus",
        "description": "Consulta profesores, notas actuales y cuánto necesitas para aprobar.",
        "url": "https://campuscli.com/app/asistente/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Blackboard conectado",
        "description": "Consulta cursos, tareas, notas y anuncios de Blackboard UPC desde asistentes compatibles.",
        "url": "https://campuscli.com/campus-cli/"
      }
    ]
  },
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Necesito crear una cuenta?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Puedes probar el asistente antes de crearla. Después, regístrate en Campus Free para tener tu cuenta y las consultas de bienvenida."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué necesito para analizar mis clases?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Campus usa las transcripciones de las grabaciones publicadas en UPC Class. Necesitas acceso al curso y que la grabación tenga transcripción disponible."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cómo activo Campus Plus?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Entra desde “Quiero Campus Plus”, inicia sesión y confirma tu universidad. La app muestra tu precio y los datos de Yape o Plin. Adjunta el comprobante y consulta ahí la confirmación del pago. Tu mes empieza al aprobarlo; no hay cobros automáticos."
      }
    },
    {
      "@type": "Question",
      "name": "¿Necesito otra suscripción para usar mi IA?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Depende del asistente compatible y de las funciones que uses. Cualquier suscripción externa se contrata por separado de Campus."
      }
    },
    {
      "@type": "Question",
      "name": "¿Puede leer cualquier fuente?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "La lectura es experimental y depende del acceso al documento. Si solo se lee el resumen o algunas páginas, se indica ese alcance. Guardar una referencia en Mendeley no da acceso al texto completo."
      }
    },
    {
      "@type": "Question",
      "name": "¿Puedo cambiar mi universidad?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí. Durante la prueba puedes cambiarla en el asistente y, con tu cuenta, desde Mi perfil. La elección se conserva al crear tu cuenta. Por ahora, el asistente y Blackboard están disponibles para UPC."
      }
    },
    {
      "@type": "Question",
      "name": "¿Campus es parte de la UPC?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Campus es un proyecto independiente, hecho por estudiantes. No está afiliado a UPC, Blackboard, OpenAI ni Anthropic."
      }
    }
  ]
}
];
---

<Base
  title={"Campus | Tu ciclo en UPC, un poco más fácil"}
  description={"Conoce Campus Free y Campus Plus para UPC. Plus: S/5 el primer mes y luego S/10 al mes para los primeros 25 usuarios de pago. Después, S/15 al mes para nuevos usuarios."}
  canonical={"https://campuscli.com/"}
  markdownUrl={"https://campuscli.com/index.md"}
  ogTitle={"Campus Free y Campus Plus | Tu universidad, más fácil"}
  ogDescription={"Empieza gratis con Campus Free. Campus Plus para los primeros 25 de pago: S/5 el primer mes y luego S/10 al mes. Nuevos usuarios después: S/15 al mes."}
  ogImageAlt={"Campus: matrícula, horarios y Blackboard UPC"}
  schemas={schemas}
>
  <Fragment set:html={body} />
  <link slot="head" rel="stylesheet" href="/campus-research.css" />
  <script src="../scripts/landing-demo.ts"></script>
  <link slot="head" rel="stylesheet" href="/campus-landing.css" />
</Base>
