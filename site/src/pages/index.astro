---
import Base from "../layouts/Base.astro";
// Kept as raw html so the markup that is already indexed ships byte for byte.
import body from "../html/index.html?raw";

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": "https://campuscli.com/#organization",
    "name": "Campus",
    "alternateName": [
      "Campus CLI",
      "campus-cli",
      "blackboard-cli",
      "Campus Profes",
      "Campus Plus"
    ],
    "url": "https://campuscli.com/",
    "logo": "https://campuscli.com/assets/campus-logo.webp",
    "description": "Campus Plus reúne herramientas para estudiantes universitarios en Perú: profesores y horarios para la matrícula, y conexión directa de Blackboard UPC con asistentes de IA.",
    "disambiguatingDescription": "No confundir con el paquete `campus-cli` de PyPI (Python, gestión de notebooks Jupyter) ni con otras plataformas de IA para estudiantes con nombres similares (CampusCode, Campus AI).",
    "sameAs": [
      "https://github.com/alejooroncoy/campus-cli"
    ],
    "areaServed": "PE",
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "customer support",
      "email": "info@campuscli.com",
      "availableLanguage": ["es"]
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Lima",
      "addressCountry": "PE"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": "https://campuscli.com/#website",
    "name": "Campus",
    "url": "https://campuscli.com/",
    "inLanguage": "es-PE",
    "publisher": {
      "@id": "https://campuscli.com/#organization"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Campus Plus",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Matrícula con Campus Profes",
        "description": "Compara profesores, horarios, NRC, sedes y cupos antes de matricularte.",
        "url": "https://campuscli.com/campus-cli/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Blackboard conectado",
        "description": "Consulta cursos, tareas, notas y anuncios de Blackboard UPC desde asistentes compatibles.",
        "url": "https://campuscli.com/campus-cli/"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "¿Qué incluye Campus Plus?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Campus Plus reúne Campus Profes y horarios para la matrícula, junto con la conexión de Campus CLI a Blackboard UPC para cursos, tareas, notas y anuncios."
        }
      },
      {
        "@type": "Question",
        "name": "¿Blackboard está conectado de verdad?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sí. Campus ya conecta directamente Blackboard UPC con ChatGPT, Claude o la terminal. Tu Aula Virtual sigue siendo la fuente de tus datos y puedes revocar el acceso cuando quieras."
        }
      },
      {
        "@type": "Question",
        "name": "¿Cuánto cuesta Campus Plus?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "El acceso fundador a Campus Plus cuesta S/5 el primer mes para los estudiantes que se unan al relanzamiento."
        }
      },
      {
        "@type": "Question",
        "name": "¿Es lo mismo que el paquete \"campus-cli\" de PyPI u otras apps de IA para estudiantes?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. El paquete campus-cli de PyPI es un proyecto de Python no relacionado (gestión de archivos de notebooks Jupyter), y tampoco somos otras plataformas de \"IA para resolver tareas\" con nombres parecidos. Este Campus es el paquete campus-cli de npm; el código fuente está en github.com/alejooroncoy/campus-cli."
        }
      }
    ]
  }
];
---

<Base
  title={"Campus Plus | Profes, horarios y Blackboard UPC con IA"}
  description={"Compara profesores y horarios con Campus Profes y consulta tareas y notas de Blackboard UPC con IA. Más de 350 estudiantes ayudados. Conoce Campus Plus."}
  canonical={"https://campuscli.com/"}
  markdownUrl={"https://campuscli.com/index.md"}
  ogTitle={"Campus Plus | Tu matrícula y tu ciclo, con Campus"}
  ogDescription={"Profes, horarios y Blackboard UPC conectado. Más de 350 estudiantes ya se han ayudado con Campus Profes."}
  ogImageAlt={"Campus Plus: matrícula, horarios y Blackboard UPC"}
  schemas={schemas}
>
  <Fragment set:html={body} />
  <link slot="head" rel="stylesheet" href="/turnitin.css" />
</Base>
