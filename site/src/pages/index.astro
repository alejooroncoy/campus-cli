---
import {CHARACTER_NAME} from '../lib/character.mjs';

import Base from "../layouts/Base.astro";
// Shared with the Markdown route so public plan details stay consistent.
import rawBody from "../html/index.html?raw";
import { publicHomeHtml } from "../../feature-flags.mjs";
// El titular sale ya partido en palabras: si lo partiera el script, se vería, desaparecería y volvería a entrar.
let word = 0;
const body = publicHomeHtml(rawBody).replace(/(<h1[^>]*data-words[^>]*>)([\s\S]*?)(<\/h1>)/, (_m, open: string, inner: string, close: string) =>
  open + inner.replace(/(<span[^>]*>)([^<]*)(<\/span>)/g, (_s, a: string, text: string, b: string) =>
    a + text.split(' ').filter(Boolean).map((w) => `<span class="w" style="--i:${word++}">${w}</span>`).join(' ') + b) + close);
const title = "Campus Plus: Blackboard UPC con IA, precios y planes";
const description = `Campus Plus para UPC: ${CHARACTER_NAME} sigue tu clase de UClass y tu IA lee tus materiales de Blackboard para tus trabajos. Precios, límites y consultas de prueba.`;

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": "https://campuscli.com/#organization",
    "name": "Campus",
    "alternateName": [
      "Campus CLI",
      "campus-cli",
      "blackboard-cli"
    ],
    "url": "https://campuscli.com/",
    "logo": "https://campuscli.com/assets/campus-logo.webp",
    "description": "Campus ayuda a estudiantes UPC a consultar profesores, cursos, tareas y notas. Ofrece Campus Free y Campus Plus, con asistente web y conexión con IA para consultar Blackboard, analizar transcripciones de clases virtuales, guardar referencias en Mendeley y usar la lectura experimental de fuentes accesibles.",
    "disambiguatingDescription": "No confundir con el paquete `campus-cli` de PyPI (Python, gestión de notebooks Jupyter) ni con otras plataformas de IA para estudiantes con nombres similares (CampusCode, Campus AI).",
    "sameAs": [
      "https://github.com/alejooroncoy/campus-cli"
    ],
    "areaServed": "PE",
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "customer support",
      "email": "info@campuscli.com",
      "availableLanguage": ["es"]
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Lima",
      "addressCountry": "PE"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": "https://campuscli.com/#website",
    "name": "Campus",
    "url": "https://campuscli.com/",
    "inLanguage": "es-PE",
    "publisher": {
      "@id": "https://campuscli.com/#organization"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Campus",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Opiniones de profesores UPC",
        "description": "Consulta reseñas de profesores y cursos antes de elegir tu sección.",
        "url": "https://campuscli.com/profes/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Blackboard conectado",
        "description": "Consulta cursos, tareas, notas y anuncios de Blackboard UPC desde asistentes compatibles.",
        "url": "https://campuscli.com/blackboard-upc/"
      }
    ]
  },
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `¿Qué es Campus Plus y cuánto cuesta?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Campus Plus es el plan de pago de Campus: ${CHARACTER_NAME} en todas tus clases de UClass, consultas ilimitadas desde tu IA con tu Blackboard, 100 consultas diarias en la web y tus clases grabadas para repasar. El precio fundador es S/10 al mes para los primeros 25 usuarios de pago; al completar ese grupo, las nuevas suscripciones cuestan S/15 al mes desde el inicio. Las suscripciones de otras IA se pagan por separado.`
      }
    },
    {
      "@type": "Question",
      "name": `¿Dónde funciona?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `${CHARACTER_NAME} en clase, por ahora en UClass de la UPC. Tu IA con tus cursos de Blackboard: UPC, UPN, Universidad de Lima y Universidad de Palermo. Tus clases grabadas: UClass en la UPC y Zoom en la Universidad de Lima y Palermo.`
      }
    },
    {
      "@type": "Question",
      "name": `¿${CHARACTER_NAME} entra a clase por mí?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `No. ${CHARACTER_NAME} solo escucha la pestaña de UClass que tú abriste con tu cuenta, en tu compu. Nunca entra solo a una clase, no responde por ti ni marca tu asistencia.`
      }
    },
    {
      "@type": "Question",
      "name": `¿${CHARACTER_NAME} graba mi micrófono?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Escucha el audio de la pestaña de UClass. Tu micrófono, solo cuando estás desmuteado en UClass. Lo transcrito queda cifrado en tu cuenta y puedes borrar cada clase.`
      }
    },
    {
      "@type": "Question",
      "name": `¿Necesito crear una cuenta?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Sí. Crea tu cuenta Campus o inicia sesión para hablar con ${CHARACTER_NAME}. Campus Free incluye 25 consultas de bienvenida en la web y 15 de prueba desde tu IA.`
      }
    },
    {
      "@type": "Question",
      "name": `¿Cómo activo Campus Plus?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Entra desde “Activar Campus Plus”, inicia sesión y confirma tu universidad. La app muestra tu precio y los datos de Yape o Plin. Adjunta el comprobante y consulta ahí la confirmación del pago. Tu mes empieza al aprobarlo; no hay cobros automáticos.`
      }
    },
    {
      "@type": "Question",
      "name": `¿Necesito otra suscripción para usar mi IA?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Depende del asistente compatible y de las funciones que uses. Cualquier suscripción externa se contrata por separado de Campus.`
      }
    },
    {
      "@type": "Question",
      "name": `¿Puede leer cualquier fuente?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `La lectura es experimental y depende del acceso al documento. Si solo se lee el resumen o algunas páginas, se indica ese alcance. Guardar una referencia en Mendeley no da acceso al texto completo.`
      }
    },
    {
      "@type": "Question",
      "name": `¿Campus es parte de la UPC?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Campus es un proyecto independiente, hecho por estudiantes. No está afiliado a la UPC ni a otras universidades, ni a Blackboard, OpenAI, Anthropic o Google.`
      }
    }
  ]
}
];
---

<Base
  title={title}
  description={description}
  canonical={"https://campuscli.com/"}
  markdownUrl={"https://campuscli.com/index.md"}
  ogTitle={title}
  ogDescription={description}
  ogImageAlt={"Campus: matrícula, horarios y Blackboard UPC"}
  schemas={schemas}
>
  <Fragment set:html={body} />
  <script src="../scripts/home.ts"></script>
  <link slot="head" rel="stylesheet" href="/campus-landing.css" />
  <link slot="head" rel="stylesheet" href="/campus-home.css" />
</Base>
