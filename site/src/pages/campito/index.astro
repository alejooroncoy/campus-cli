---
import Base from '../../layouts/Base.astro';
import rawBody from '../../html/campito/index.html?raw';
import { campitoPageHtml, campitoTrialEnabled } from '../../../feature-flags.mjs';
const body = campitoPageHtml(rawBody);
const url = 'https://campuscli.com/campito/';
const store = 'https://chromewebstore.google.com/detail/dhkmcgkafhfhelolngmdgepiddjmphld';
const description = campitoTrialEnabled
  ? 'Campito acompaña tu clase de UClass: toma apuntes con el minuto de cada cosa, te responde qué acaba de explicar el profe y al terminar te deja lo que hay que entregar. Tu primera clase es gratis.'
  : 'Campito acompaña tu clase de UClass: toma apuntes con el minuto de cada cosa, te responde qué acaba de explicar el profe y al terminar te deja lo que hay que entregar. Con Campus Plus desde S/10 al mes para los primeros 25 de pago.';
const image = 'https://campuscli.com/assets/og-default.jpg';
const schemas = [
  { '@context': 'https://schema.org', '@type': 'WebPage', '@id': url + '#webpage', url,
    name: 'Campito: tus clases de UClass, con apuntes y su minuto | Campus', description, inLanguage: 'es-PE',
    dateModified: '2026-11-19', mainEntity: { '@id': url + '#app' }, breadcrumb: { '@id': url + '#breadcrumb' } },
  { '@context': 'https://schema.org', '@type': 'SoftwareApplication', '@id': url + '#app',
    name: 'Campito', applicationCategory: 'EducationalApplication', operatingSystem: 'Chrome', url, downloadUrl: store, description,
    publisher: { '@type': 'Organization', '@id': 'https://campuscli.com/#organization', name: 'Campus', url: 'https://campuscli.com/' } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', '@id': url + '#breadcrumb',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://campuscli.com/' },
      { '@type': 'ListItem', position: 2, name: 'Campito', item: url } ] },
];
---
<Base title="Campito: tus clases de UClass, con apuntes y su minuto | Campus" description={description}
  headerAction={{ label: 'Instalar', href: store + '?utm_source=campuscli&utm_medium=web&utm_campaign=campito' }}
  canonical={url} markdownUrl={url + 'index.md'} schemas={schemas}
  ogTitle="Lo que el profe dice una sola vez, guardado"
  ogImage={image} ogImageType="image/jpeg"
  ogImageAlt="Campito, la extensión de Campus para tus clases de UClass.">
  <link slot="head" rel="stylesheet" href="/campus-landing.css" />
  <link slot="head" rel="stylesheet" href="/campito.css?v=1" />
  <Fragment set:html={body} />
  <script>import '../../scripts/campito-landing.ts';</script>
</Base>
