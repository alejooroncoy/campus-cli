---
import AppShell from '../../../layouts/AppShell.astro';
import CampuUpdates from '../../../components/CampuUpdates';
import WhatsAppReminders from '../../../components/WhatsAppReminders.astro';
import WhatsAppStrip from '../../../components/WhatsAppStrip.astro';
---
<AppShell title="Tu calendario" active="calendario">
  <script is:inline>
    // El reporte ya está preparado en el servidor: se pide apenas llega el HTML, en
    // paralelo con la sesión (campus-session-bootstrap.js), sin esperar a que cargue la parte interactiva.
    (() => {
      if (new URLSearchParams(location.search).has("baja")) return;
      const get = (url, ms = 25000) =>
        fetch(url, { credentials: "same-origin", cache: "no-store", signal: AbortSignal.timeout(ms) })
          .then(async (r) => ({ ok: r.ok, data: await r.json() }));
      const id = location.pathname.match(/^\/app\/novedades\/([0-9a-f-]{36})\/?$/i)?.[1];
      const early = { at: Date.now() };
      // La página entera en una consulta. Si el relay no puede armarla, se adelantan
      // en seguida las consultas de siempre, antes de que el componente las pida.
      const page = id ? "/page/" + id : "/page";
      // Armarla debe ser rápido: si falla o tarda, cuenta como "no lista" (no null, que
      // haría al componente pedirla otra vez) y se sigue con las consultas de siempre.
      early[page] = get("/api/app/proactive" + page + "/", 8000)
        .catch(() => ({ ok: false, data: { error: "PAGE_PREFETCH_FAILED" } }))
        .then((r) => {
          if (r && r.ok) return r;
          for (const k of ["/status", "/notices", id ? "/notices/" + id : "/week"])
            early[k] = get("/api/app/proactive" + k + "/").catch(() => null);
          return r;
        });
      window.__campuPrefetch = early;
    })();
  </script>
  <div class="novedades-layout">
    <div class="novedades-main">
      <div class="novedades-strip"><WhatsAppStrip /></div>
      <!-- "Tus entregas en Google Calendar" debajo de WhatsApp: CampuUpdates elige el lugar. -->
      <div class="novedades-cal" data-cal-slot="main"></div>
      <CampuUpdates client:load />
    </div>
    <aside class="novedades-extra" aria-label="Tu semana en WhatsApp">
      <WhatsAppReminders />
      <div class="novedades-cal" data-cal-slot="side"></div>
    </aside>
  </div>
</AppShell>
<style is:global>
  /* La tarjeta de WhatsApp va fuera del componente de React. En celular y en
     pantallas medianas va abajo, con los mismos márgenes; en escritorio, en la
     vista simple, pasa a una columna a la derecha que acompaña al calendario. */
  .novedades-extra {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 clamp(16px, 3vw, 36px) clamp(16px, 3vw, 36px);
  }
  @media (max-width: 760px) {
    .novedades-extra {
      padding: 0 10px 16px;
    }
  }
  /* Franja de WhatsApp: en celular y pantallas medianas, arriba del calendario en la vista
     simple. Abre la tarjeta completa en una hoja inferior. */
  .novedades-strip {
    padding: 0 clamp(16px, 3vw, 36px);
  }
  @media (max-width: 760px) {
    .novedades-strip {
      padding: 0 10px;
    }
  }
  .novedades-layout:not(:has(.campu-home)) .novedades-strip,
  .novedades-layout:has(#avisos) .novedades-strip {
    display: none;
  }
  /* El calendario va debajo de WhatsApp. Sin él, los huecos no ocupan espacio. */
  .novedades-cal:empty {
    display: none;
  }
  .novedades-cal .campu-cal-slot {
    max-width: none;
    margin: 0;
    padding: 0;
  }
  .novedades-cal .campu-cal-sync {
    margin: 0;
  }
  .novedades-main > .novedades-cal {
    max-width: 640px;
    margin: 12px auto 0;
    padding: 0 clamp(16px, 3vw, 36px);
    box-sizing: content-box;
  }
  @media (max-width: 760px) {
    .novedades-main > .novedades-cal {
      padding: 0 10px;
    }
  }
  .novedades-extra > .novedades-cal {
    max-width: 640px;
    margin: 16px auto 0;
  }
  @media (min-width: 1240px) {
    /* Con el calendario, la columna ya no entra en la pantalla: fija, se cortaría abajo. */
    .novedades-layout .novedades-extra:has(.novedades-cal:not(:empty)) {
      position: static;
    }
  }
  /* Con la franja visible, la tarjeta solo se abre desde ella: abajo no se repite. Al
     tocar la franja, la tarjeta pasa a la hoja, que está fuera de esta columna. */
  @media (max-width: 1239px) {
    .novedades-layout:has(.campu-home):not(:has(#avisos)):has(.wa-strip:not([hidden])) .novedades-extra {
      display: none;
    }
  }
  .novedades-layout:has(.campu-home):not(:has(#avisos)) .wa-card {
    max-width: 640px;
    margin-inline: auto;
    grid-template-columns: minmax(0, 1fr) minmax(200px, 240px);
    gap: 22px;
  }
  @media (max-width: 720px) {
    .novedades-layout:has(.campu-home):not(:has(#avisos)) .wa-card {
      grid-template-columns: 1fr;
    }
  }
  @media (min-width: 1240px) {
    .novedades-layout:has(.campu-home):not(:has(#avisos)):has(.wa-card:not([hidden])) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 300px;
      column-gap: 28px;
      align-items: start;
      max-width: 1120px;
      margin: 0 auto;
      padding-right: clamp(16px, 3vw, 36px);
    }
    .novedades-layout:has(.campu-home):not(:has(#avisos)) .novedades-strip {
      display: none;
    }
    .novedades-layout:has(.campu-home):not(:has(#avisos)):has(.wa-card:not([hidden])) .campu-updates {
      padding-right: 0;
    }
    .novedades-layout:has(.campu-home):not(:has(#avisos)):has(.wa-card:not([hidden])) .novedades-extra {
      position: sticky;
      top: 24px;
      margin: 0;
      max-width: none;
      padding: clamp(16px, 3vw, 36px) 0 24px;
    }
    .novedades-layout:has(.campu-home):not(:has(#avisos)) .novedades-extra .wa-card {
      max-width: none;
      grid-template-columns: 1fr;
      gap: 18px;
      padding: 20px;
    }
    .novedades-extra .wa-card h2 {
      font-size: 17px;
    }
    .novedades-extra .wa-card__lead {
      font-size: 13px;
    }
    .novedades-extra .wa-chat {
      padding: 12px 10px;
    }
    .novedades-extra .wa-chat__bubble {
      font-size: 12px;
    }
  }
</style>
