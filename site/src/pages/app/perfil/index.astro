---
import AppShell from "../../../layouts/AppShell.astro";
import CorrectionEmailPreference from '../../../components/CorrectionEmailPreference';
import MarketingAccountPreference from '../../../components/MarketingAccountPreference';
import '../../../styles/profile.css';

const sections = [
  { id: 'cuenta', label: 'Cuenta', icon: 'user' },
  { id: 'plan', label: 'Plan y uso', icon: 'file-text' },
  { id: 'conexiones', label: 'Conexiones', icon: 'graduation-cap' },
  { id: 'preferencias', label: 'Preferencias', icon: 'shield-check' },
];
---
<AppShell title="Mi perfil" active="perfil">
  <section class="app-profile-loading" data-app-profile-loading role="status" aria-live="polite" aria-atomic="true">
    <span class="app-sr-only">Comprobando tu cuenta…</span>
    <div class="app-profile-loading__skeleton" aria-hidden="true">
      <span class="app-skeleton app-skeleton--short"></span>
      <div class="app-profile-loading__skeleton-card"><span class="app-skeleton app-skeleton--short"></span><span class="app-skeleton app-skeleton--title"></span><span class="app-skeleton app-skeleton--line"></span></div>
      <div class="app-profile-loading__skeleton-card"><span class="app-skeleton app-skeleton--short"></span><span class="app-skeleton app-skeleton--line"></span><span class="app-skeleton app-skeleton--line"></span></div>
    </div>
  </section>

  <section class="app-profile-entry" data-app-profile-error hidden role="status">
    <div class="app-profile-entry__content">
      <h1>No pudimos cargar tu perfil</h1>
      <p>Vuelve a intentarlo para consultar tu cuenta y tu saldo.</p>
      <button class="app-button" type="button" data-profile-refresh>Volver a intentar</button>
    </div>
  </section>

  <section class="app-profile-entry" data-app-profile-guest hidden>
    <div class="app-profile-entry__content">
      <h1>Entra a Campus</h1>
      <p class="app-profile-entry__lead">Crea tu cuenta gratis para guardar tus conversaciones y recibir 25 consultas de bienvenida.</p>
      <a class="app-button app-profile-entry__button" data-app-login href="/api/app/auth/start?return=%2Fapp%2Fperfil%2F">Crear cuenta o iniciar sesión <svg class="site-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><use href="/assets/lucide.svg#arrow-right"></use></svg></a>
      <p class="app-profile-entry__note">Las 25 consultas son de bienvenida; no se renuevan cada mes.</p>
      <p class="app-profile-entry__status" data-app-status role="status" aria-live="polite"></p>
    </div>
  </section>

  <section class="app-profile-university" data-app-profile-university hidden>
    <button class="app-profile-university__cancel" type="button" data-app-cancel-university hidden><svg class="site-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><use href="/assets/lucide.svg#arrow-left"></use></svg> Volver a mi perfil</button>
    <p class="app-profile-entry__eyebrow">PERSONALIZA TU CAMPUS</p>
    <h1>¿En qué universidad estudias?</h1>
    <p>Cuéntanos dónde estudias para personalizar Campus. Puedes usar el agente aunque todavía no tengamos datos de tus profesores o cursos.</p>
    <form data-app-university-form>
      <label for="app-university">Tu universidad</label>
      <input id="app-university" name="university" list="app-university-options" autocomplete="off" placeholder="Busca tu universidad…" required />
      <datalist id="app-university-options" data-app-university-options></datalist>
      <label class="app-university-declared"><input type="checkbox" data-app-university-not-listed /> Mi universidad no aparece en la lista</label>
      <div class="app-university-loading" data-app-universities-loading role="status" aria-live="polite" hidden><span class="app-sr-only">Cargando universidades…</span><span class="app-skeleton app-skeleton--line" aria-hidden="true"></span><span class="app-skeleton app-skeleton--short" aria-hidden="true"></span></div>
      <button class="app-university-quick" type="button" data-app-select-upc aria-pressed="false" hidden>Estudio en UPC</button>
      <button class="app-button" type="submit"><span data-app-university-submit-label>Guardar y continuar</span><span class="app-skeleton app-skeleton--short" data-app-university-submit-skeleton aria-hidden="true" hidden></span><svg class="site-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><use href="/assets/lucide.svg#arrow-right"></use></svg></button>
    </form>
    <p class="app-profile-university__note">Tu elección se guarda en Mi perfil y puedes cambiarla. Elegir universidad no conecta tu Aula Virtual; esa autorización se hace aparte.</p>
    <p class="app-profile-university__status" data-app-university-status role="status" aria-live="polite"></p>
  </section>

  <div class="campus-profile" data-app-profile-authenticated hidden>
    <header class="profile-heading">
      <h1>Mi perfil</h1>
      <p>Gestiona tu cuenta y tus conexiones.</p>
    </header>

    <nav class="profile-index" aria-label="Secciones de Mi perfil">
      {sections.map(({ id, label, icon }) => (
        <a href={`#${id}`}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><use href={`/assets/lucide.svg#${icon}`}></use></svg>
          {label}
        </a>
      ))}
    </nav>

    <div class="profile-overview">
      <section class="profile-card profile-account" id="cuenta" aria-labelledby="profile-account-title">
        <h2 id="profile-account-title">Tu cuenta</h2>
        <div class="profile-identity">
          <div class="profile-avatar" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="24" height="24"><use href="/assets/lucide.svg#user"></use></svg>
            <span data-app-profile-initials hidden></span>
          </div>
          <div>
            <p class="profile-identity__name" data-app-profile-name>Cuenta Campus</p>
            <p data-app-email></p>
          </div>
        </div>
        <div class="profile-row">
          <div class="profile-row__body">
            <h3>Universidad</h3>
            <p data-app-university-name>Por comprobar</p>
            <p class="profile-note" data-app-profile-coverage hidden>Puedes usar el agente para estudiar y preparar trabajos. Todavía no tenemos datos verificados de profesores o cursos de tu universidad.</p>
          </div>
          <button class="app-button app-button--secondary" type="button" data-app-change-university>Cambiar universidad</button>
        </div>
      </section>

      <section class="profile-card profile-plan" id="plan" data-profile-account aria-labelledby="profile-plan-title">
        <p class="profile-plan__label">Plan y uso</p>
        <h2 id="profile-plan-title" data-profile-label>Comprobando…</h2>
        <div class="profile-plan__quota">
          <p class="profile-plan__label">Consultas web</p>
          <p class="profile-plan__balance" data-profile-usage aria-live="polite" hidden></p>
          <meter data-profile-meter aria-hidden="true" hidden></meter>
          <p class="profile-note" data-profile-note>Estamos comprobando tu plan y tu saldo.</p>
        </div>
        <p class="profile-note" data-profile-mcp hidden></p>
        <div class="profile-plan__actions">
          <a class="app-button" href="/app/plus/" data-profile-upgrade hidden>Activar Campus Plus</a>
          <a class="app-button" href="/app/plus/" data-profile-manage hidden>Suscripción y pagos</a>
          <button class="app-button app-button--secondary" type="button" data-profile-refresh>Actualizar saldo</button>
        </div>
      </section>
    </div>

    <section class="profile-group" id="conexiones" aria-labelledby="profile-connections-title">
      <header class="profile-group__heading">
        <h2 id="profile-connections-title">Conexiones</h2>
        <p>Consulta tus datos académicos y usa Campus desde tu IA.</p>
      </header>
      <div class="profile-card profile-list">
        <div class="profile-row" data-app-banner hidden>
          <svg class="profile-row__icon" viewBox="0 0 24 24" width="21" height="21" aria-hidden="true"><use href="/assets/lucide.svg#graduation-cap"></use></svg>
          <div class="profile-row__body">
            <h3>Matrícula (Banner)</h3>
            <p data-app-banner-details>Horario y matrícula de la UPC.</p>
          </div>
          <span class="profile-badge" data-app-banner-status>Por comprobar</span>
        </div>
        <div class="profile-row" id="miupc" hidden>
          <svg class="profile-row__icon" viewBox="0 0 24 24" width="21" height="21" aria-hidden="true"><use href="/assets/lucide.svg#book-open"></use></svg>
          <div class="profile-row__body">
            <h3>Notas actuales (Mi UPC)</h3>
            <p data-miupc-status role="status" aria-live="polite" aria-atomic="true">Comprobando tu conexión…</p>
          </div>
          <div class="profile-row__actions">
            <button class="app-button app-button--secondary" type="button" data-miupc-connect disabled>Conectar Mi UPC</button>
            <a class="app-text-link" data-miupc-login target="_blank" rel="noopener noreferrer" hidden>Abrir acceso seguro ↗</a>
          </div>
        </div>
        <div class="profile-row">
          <svg class="profile-row__icon" viewBox="0 0 24 24" width="21" height="21" aria-hidden="true"><use href="/assets/lucide.svg#sparkles"></use></svg>
          <div class="profile-row__body">
            <h3>Tu asistente de IA (MCP)</h3>
            <p>Usa tu cuenta Campus para consultar desde una IA compatible.</p>
          </div>
          <a class="app-button app-button--secondary" href="/app/copilot/">Conectar mi IA</a>
        </div>
      </div>
    </section>

    <section class="profile-group" id="preferencias" aria-labelledby="profile-preferences-title">
      <header class="profile-group__heading">
        <h2 id="profile-preferences-title">Preferencias</h2>
        <p>Elige qué avisos recibes y qué datos compartes.</p>
      </header>
      <div class="profile-preferences">
        <div class="profile-card profile-row">
          <div class="profile-row__body">
            <h3>Novedades de tu Aula Virtual <span class="profile-badge">Piloto UPC</span></h3>
            <p>Resúmenes semanales y novedades de tus cursos.</p>
          </div>
          <a class="app-button app-button--secondary" href="/app/novedades/">Ver novedades y ajustes</a>
        </div>
        <CorrectionEmailPreference client:load />
        <MarketingAccountPreference client:load />
        <details class="profile-card app-memory" data-memory-root>
          <summary>
            <span><strong>Lo que Campus recuerda de ti</strong><span>Tus preferencias y metas entre chats.</span></span>
            <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><use href="/assets/lucide.svg#arrow-down"></use></svg>
          </summary>
          <div class="profile-memory__content">
            <p data-memory-status role="status" aria-live="polite">Abre esta sección para ver tu memoria.</p>
            <div data-memory-list></div>
            <p>Desactivar la memoria también borra los recuerdos guardados.</p>
            <div class="app-actions">
              <button class="app-button app-button--secondary" type="button" data-memory-refresh>Actualizar</button>
              <button class="app-text-link" type="button" data-memory-toggle hidden>Desactivar memoria</button>
              <button class="app-text-link" type="button" data-memory-clear hidden>Olvidar todos los recuerdos</button>
            </div>
          </div>
        </details>
      </div>
    </section>

    <footer class="profile-footer">
      <a class="app-text-link" href="/opiniones-campus/#compartir">Opinar sobre Campus <span aria-hidden="true">↗</span></a>
      <button class="app-button app-button--secondary" type="button" data-app-logout hidden>
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><use href="/assets/lucide.svg#power"></use></svg>
        Cerrar sesión
      </button>
    </footer>
  </div>
  <p class="profile-guest-feedback"><a class="app-text-link" href="/opiniones-campus/#compartir">Opinar sobre Campus <span aria-hidden="true">↗</span></a></p>
</AppShell>

<script>
  import "../../../scripts/miupc-profile";
  import "../../../scripts/user-memory";
</script>
