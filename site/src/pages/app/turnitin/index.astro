---
import { turnitinServiceEnabled } from "../../../../feature-flags.mjs";
import AppShell from '../../../layouts/AppShell.astro';
import TurnitinLogin from '../../../components/TurnitinLogin.astro';
import TurnitinReportViewer from '../../../components/TurnitinReportViewer.astro';
---
<AppShell title="Informes de Turnitin" active="turnitin">
  <link rel="stylesheet" href="/turnitin.css?v=2" />
  <div class="ti-order-shell">
    <header class="ti-order-head">
      <h1>{turnitinServiceEnabled ? "Turnitin" : "Tus revisiones de Turnitin"}</h1>
      {turnitinServiceEnabled && <a class="ti-service-link" href="/turnitin/" aria-label="Detalles del servicio">Detalles <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><use href="/assets/lucide.svg#arrow-up-right"></use></svg></a>}
      <p>{turnitinServiceEnabled ? "Elige IA o similitud por S/10, o ambos informes por S/15." : "Los pedidos nuevos están pausados. Consulta tus informes anteriores aquí."}</p>
      {turnitinServiceEnabled && <div class="ti-service-facts"><span>10 min a 1 h tras validar el pago y el archivo</span></div>}
    </header>
    <p class="ti-status" data-ti-status role="status" aria-live="polite"><span class="app-sr-only">Comprobando disponibilidad…</span><span class="ti-inline-skeleton" aria-hidden="true"></span></p>
    <section class="ti-capacity-notice" data-ti-capacity-notice hidden aria-labelledby="ti-capacity-title">
      <div role="status" aria-live="polite"><h2 id="ti-capacity-title" data-ti-capacity-title>Revisiones no disponibles por ahora</h2><p data-ti-capacity-message></p></div>
      <div class="ti-capacity-actions"><button type="button" class="app-button app-button--secondary" data-ti-check-capacity>Comprobar disponibilidad</button><a href="https://wa.me/51946189585?text=Hola%2C%20necesito%20ayuda%20con%20mi%20revisi%C3%B3n%20de%20Turnitin%20en%20Campus." target="_blank" rel="noopener noreferrer">Ya pagué · Contactar soporte</a></div>
    </section>
    <div class="ti-order-layout">
      <section class="ti-panel ti-reviews" aria-labelledby="ti-my-orders" data-ti-my-orders-panel>
        <div class="ti-panel-head"><div><h2 id="ti-my-orders">Mis revisiones</h2><p>Consulta el estado y descarga tus PDF.</p></div><button class="app-button app-button--secondary" type="button" data-ti-refresh hidden><span data-ti-refresh-label>Actualizar</span><span class="ti-inline-skeleton ti-inline-skeleton--button" data-ti-refresh-skeleton aria-hidden="true" hidden></span></button></div>
        <div class="ti-history-tools" data-ti-history-tools hidden>
          <label class="ti-history-search">Buscar un trabajo<input type="search" placeholder="Nombre de tu documento" maxlength="180" data-ti-search /></label>
          <div class="ti-history-filters" role="group" aria-label="Filtrar revisiones por estado">
            <button type="button" data-ti-filter="all" aria-pressed="true">Todas <span data-ti-count="all">0</span></button>
            <button type="button" data-ti-filter="completed" aria-pressed="false">Listas <span data-ti-count="completed">0</span></button>
            <button type="button" data-ti-filter="processing" aria-pressed="false">En revisión <span data-ti-count="processing">0</span></button>
            <button type="button" data-ti-filter="payment_review" aria-pressed="false">Validando pago <span data-ti-count="payment_review">0</span></button>
            <button type="button" data-ti-filter="payment_rejected" aria-pressed="false">Pago observado <span data-ti-count="payment_rejected">0</span></button>
          </div>
          <p class="ti-history-count" data-ti-history-count role="status" aria-live="polite"></p>
        </div>
        <div data-ti-orders aria-busy="true"><div class="ti-orders-skeleton" role="status" aria-label="Cargando tus revisiones"><article class="ti-order-skeleton"><span class="ti-inline-skeleton ti-inline-skeleton--title" aria-hidden="true"></span><span class="ti-inline-skeleton ti-inline-skeleton--line" aria-hidden="true"></span><span class="ti-inline-skeleton ti-inline-skeleton--line-short" aria-hidden="true"></span><span class="ti-inline-skeleton ti-inline-skeleton--block" aria-hidden="true"></span></article><article class="ti-order-skeleton"><span class="ti-inline-skeleton ti-inline-skeleton--title" aria-hidden="true"></span><span class="ti-inline-skeleton ti-inline-skeleton--line" aria-hidden="true"></span><span class="ti-inline-skeleton ti-inline-skeleton--line-short" aria-hidden="true"></span></article></div></div>
        <button class="app-button app-button--secondary ti-history-more" type="button" data-ti-more hidden><span data-ti-more-label>Ver más revisiones</span><span class="ti-inline-skeleton ti-inline-skeleton--button" data-ti-more-skeleton aria-hidden="true" hidden></span></button>
        <p class="ti-muted ti-report-note" hidden>El informe de IA puede mostrar «*%» en lugar de un porcentaje exacto.</p>
      </section>

      <TurnitinLogin inline />
      <details class="ti-panel ti-new-order" data-ti-new-order data-ti-service-enabled={String(turnitinServiceEnabled)} hidden={!turnitinServiceEnabled} open={turnitinServiceEnabled}>
        <summary><span class="ti-summary-title">Nueva revisión</span><span class="ti-price-badge" data-ti-price>S/15 · Similitud + IA</span><span class="ti-disclosure" aria-hidden="true"></span></summary>
        <div class="ti-new-order-body">
        <form data-ti-form hidden novalidate>
          <fieldset data-ti-fields style="border:0;padding:0;margin:0">
            <nav class="ti-request-progress" aria-label="Pasos de tu revisión">
              <button type="button" data-ti-go-step="document" aria-current="step"><span>1</span> Documento</button>
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><use href="/assets/lucide.svg#chevron-right"></use></svg>
              <button type="button" data-ti-go-step="payment"><span>2</span> Pago y envío</button>
            </nav>
            <div class="ti-submit-grid">
              <section class="ti-step" data-ti-request-step="document" aria-labelledby="ti-document-title">
                <h3 id="ti-document-title" tabindex="-1">Sube tu documento</h3>
                <p class="ti-muted">Elige la revisión y la versión de tu documento.</p>
                <p class="ti-field-help">Procesamiento mediante TurnitPro. Los resultados pueden diferir de una revisión institucional de Turnitin.</p>
                <fieldset class="ti-product-picker">
                  <legend>¿Qué informe necesitas?</legend>
                  <div class="ti-product-options">
                    <label><input type="radio" name="report" value="ai" /><span class="ti-product-copy"><span>Solo IA</span><strong>S/10</strong><small class="ti-option-status" data-ti-option-status="ai">Comprobando…</small></span></label>
                    <label><input type="radio" name="report" value="similarity" /><span class="ti-product-copy"><span>Solo similitud</span><strong>S/10</strong><small class="ti-option-status" data-ti-option-status="similarity">Comprobando…</small></span></label>
                    <label><input type="radio" name="report" value="both" checked /><span class="ti-product-copy"><span>Similitud + IA</span><strong>S/15</strong><small class="ti-option-status" data-ti-option-status="both">Comprobando…</small></span></label>
                  </div>
                  <div class="ti-availability-bar"><p class="ti-field-help" data-ti-availability role="status" aria-live="polite" hidden></p><button type="button" class="ti-capacity-check" data-ti-check-capacity>Comprobar disponibilidad</button></div>
                </fieldset>
                <label class="ti-upload" data-ti-upload tabindex="0" aria-label="Seleccionar documento para revisar">
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h5"/></svg>
                  <span class="ti-upload-title" id="ti-document-label">Seleccionar documento</span>
                  <span class="ti-upload-name" data-ti-filename="document">PDF o Word (.docx) · Hasta 20 MB</span>
                  <input name="document" type="file" accept=".pdf,.docx" aria-labelledby="ti-document-label" aria-describedby="ti-document-help ti-document-error" tabindex="-1" required />
                </label>
                <p class="ti-upload-methods"><span class="ti-mobile-method">Toca el recuadro para elegir o cambiar el archivo.</span><span class="ti-desktop-method">Haz clic, arrastra o pega un archivo copiado.</span></p>
                <button class="ti-remove-file" type="button" data-ti-remove="document" hidden>Quitar documento</button>
                <p class="ti-upload-error" id="ti-document-error" data-ti-upload-error="document" role="alert" hidden></p>
                <details class="ti-file-requirements"><summary>Requisitos del documento</summary><p class="ti-field-help" id="ti-document-help">PDF con texto seleccionable o Word (.docx). Verificamos que el archivo sea compatible antes de procesarlo.</p></details>
                <div class="ti-step-action"><button class="app-button" type="button" data-ti-next>Continuar al pago <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><use href="/assets/lucide.svg#arrow-right"></use></svg></button><span class="ti-field-help">Tu archivo se enviará al confirmar.</span></div>
              </section>
              <section class="ti-step" data-ti-request-step="payment" aria-labelledby="ti-payment-title" hidden>
                <div class="ti-selected-document"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><use href="/assets/lucide.svg#file-text"></use></svg><div><span>Tu documento</span><strong data-ti-document-summary></strong></div><button type="button" data-ti-go-step="document">Cambiar</button></div>
                <h3 id="ti-payment-title" tabindex="-1">Confirma tu pago</h3>
                <p class="ti-muted">Paga por Yape o Plin y adjunta tu comprobante. Recibirás los informes que elegiste en este pedido.</p>
                <p class="ti-field-help ti-payment-availability" data-ti-payment-availability role="status" aria-live="polite"></p>
                <div class="ti-payment">
                  <div class="ti-payment-top"><span>Total por tu revisión · <span data-ti-product-summary>Similitud + IA</span></span><strong data-ti-amount>S/15</strong></div>
                  <dl><div><dt>Número de celular</dt><dd><span data-ti-phone>—</span><button type="button" class="ti-copy-phone" data-ti-copy-phone aria-label="Copiar número de Yape o Plin"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><use href="/assets/lucide.svg#copy"></use></svg><span data-ti-copy-label>Copiar</span></button></dd></div><div><dt>Titular</dt><dd data-ti-holder>—</dd></div></dl>
                  <p class="ti-field-help">Verifica el titular antes de pagar. La disponibilidad se confirma al enviar tu documento y comprobante.</p>
                </div>
                <label class="ti-upload ti-upload--receipt" data-ti-upload tabindex="0" aria-label="Adjuntar comprobante de pago">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 16V4m-4 4 4-4 4 4M4 16v4h16v-4"/></svg>
                  <span><span class="ti-upload-title" id="ti-receipt-label">Adjuntar comprobante</span><span class="ti-upload-name" data-ti-filename="receipt">PNG, JPG o PDF · Hasta 5 MB</span></span>
                  <input name="receipt" type="file" accept=".png,.jpg,.jpeg,.pdf" aria-labelledby="ti-receipt-label" aria-describedby="ti-receipt-help ti-receipt-error" tabindex="-1" required />
                </label>
                <p class="ti-upload-methods" id="ti-receipt-help"><span class="ti-mobile-method">Elige la captura o el PDF de tu pago.</span><span class="ti-desktop-method">Haz clic, arrastra o pega tu comprobante.</span></p>
                <button class="ti-remove-file" type="button" data-ti-remove="receipt" hidden>Quitar comprobante</button>
                <p class="ti-upload-error" id="ti-receipt-error" data-ti-upload-error="receipt" role="alert" hidden></p>
            <div class="ti-submit-footer">
            <label class="ti-consent"><input name="consent" type="checkbox" required /><span>Autorizo a Campus a procesar mi documento mediante TurnitPro y he leído las <a href="/turnitin/#como-funciona">condiciones del servicio</a> y la <a href="/privacidad/">política de privacidad</a>.</span></label>
            <div class="ti-submit-action"><p class="ti-field-help">Sigue el estado y descarga tus informes en Mis revisiones.</p><button class="app-button" type="submit"><span data-ti-submit-text>Enviar revisión</span><span class="ti-inline-skeleton ti-inline-skeleton--button" data-ti-submit-skeleton aria-hidden="true" hidden></span> <svg class="site-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><use href="/assets/lucide.svg#arrow-right"></use></svg></button></div>
            <p class="ti-submit-status" data-ti-submit-status role="status" aria-live="polite" hidden></p>
            </div>
              </section>
            </div>
          </fieldset>
        </form>
        <noscript>Activa JavaScript para enviar tu documento y consultar los informes.</noscript>
        </div>
      </details>

    </div>

  </div>
  <TurnitinReportViewer />
  <script src="../../../scripts/turnitin.ts"></script>
</AppShell>
