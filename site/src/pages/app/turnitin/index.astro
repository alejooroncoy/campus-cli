---
import AppShell from '../../../layouts/AppShell.astro';
import TurnitinLogin from '../../../components/TurnitinLogin.astro';
import TurnitinReportViewer from '../../../components/TurnitinReportViewer.astro';
---
<AppShell title="Informes de Turnitin" active="turnitin">
  <link rel="stylesheet" href="/turnitin.css" />
  <div class="ti-order-shell">
    <header class="ti-order-head">
      <p class="eyebrow">Campus · Turnitin</p>
      <h1>Tu trabajo, listo para revisar.</h1>
      <p>Solicita tus informes de similitud e IA y consúltalos aquí.</p>
      <div class="ti-service-facts"><span>Dos informes PDF</span><span>10 min a 1 h después de validar el pago</span><a href="/turnitin/">Detalles del servicio ↗</a></div>
    </header>
    <p class="ti-status" data-ti-status role="status" aria-live="polite">Comprobando disponibilidad…</p>
    <div class="ti-order-layout">
      <section class="ti-panel ti-reviews" aria-labelledby="ti-my-orders" data-ti-my-orders-panel>
        <div class="ti-panel-head"><div><h2 id="ti-my-orders">Mis revisiones</h2><p>Abre tus informes de similitud e IA o descarga los PDF.</p></div><button class="app-button app-button--secondary" type="button" data-ti-refresh hidden>Actualizar</button></div>
        <div data-ti-orders><p class="ti-muted">Inicia sesión para consultar tus revisiones.</p></div>
        <p class="ti-muted ti-report-note">El resultado de IA puede mostrar «*%» en lugar de un porcentaje exacto. Encontrarás el resultado disponible dentro de tu informe.</p>
      </section>

      <details class="ti-panel ti-new-order" data-ti-new-order open>
        <summary><span class="ti-summary-title"><span>Solicitar una revisión</span><span class="ti-new-order-hint">Tu documento y comprobante, en un solo envío.</span></span><span class="ti-price-badge" data-ti-price>S/8 · Lanzamiento</span><span class="ti-disclosure" aria-hidden="true"></span></summary>
        <div class="ti-new-order-body">
        <p data-ti-login hidden><a href="/api/app/auth/start?return=/app/turnitin/" data-ti-open-login>Revisar mi trabajo: iniciar sesión →</a></p>
        <form data-ti-form hidden>
          <fieldset data-ti-fields style="border:0;padding:0;margin:0">
            <div class="ti-submit-grid">
              <section class="ti-step" aria-labelledby="ti-document-title">
                <h3 id="ti-document-title"><span class="ti-step-number">1</span> Sube tu trabajo</h3>
                <p class="ti-muted">Elige el documento que deseas revisar.</p>
                <label class="ti-upload" data-ti-upload tabindex="0" aria-label="Documento: selecciona, arrastra o pega un archivo">
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h5"/></svg>
                  <span class="ti-upload-title" id="ti-document-label">Seleccionar documento</span>
                  <span class="ti-upload-name" data-ti-filename="document">PDF o Word (.docx) · Hasta 10 MB</span>
                  <input name="document" type="file" accept=".pdf,.docx" aria-labelledby="ti-document-label" aria-describedby="ti-document-help ti-document-error" tabindex="-1" required />
                </label>
                <p class="ti-upload-methods">Haz clic, arrastra o pega un archivo copiado.</p>
                <button class="ti-remove-file" type="button" data-ti-remove="document" hidden>Quitar documento</button>
                <p class="ti-upload-error" id="ti-document-error" data-ti-upload-error="document" role="alert" hidden></p>
                <p class="ti-field-help" id="ti-document-help">El PDF debe tener texto seleccionable. Para el informe de IA: entre 300 y 30 000 palabras de prosa.</p>
              </section>
              <section class="ti-step" aria-labelledby="ti-payment-title">
                <h3 id="ti-payment-title"><span class="ti-step-number">2</span> Paga y adjunta el comprobante</h3>
                <div class="ti-payment">
                  <div class="ti-payment-top"><span>Yape o Plin · Por documento</span><strong data-ti-amount>S/8</strong></div>
                  <dl><div><dt>Número de celular</dt><dd data-ti-phone>—</dd></div><div><dt>Titular</dt><dd data-ti-holder>—</dd></div></dl>
                  <p class="ti-field-help">Verifica el titular antes de pagar. Precio regular: S/10.</p>
                </div>
                <label class="ti-upload ti-upload--receipt" data-ti-upload tabindex="0" aria-label="Comprobante: selecciona, arrastra o pega un archivo">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 16V4m-4 4 4-4 4 4M4 16v4h16v-4"/></svg>
                  <span><span class="ti-upload-title" id="ti-receipt-label">Adjuntar comprobante</span><span class="ti-upload-name" data-ti-filename="receipt">PNG, JPG o PDF · Hasta 5 MB</span></span>
                  <input name="receipt" type="file" accept=".png,.jpg,.jpeg,.pdf" aria-labelledby="ti-receipt-label" aria-describedby="ti-receipt-error" tabindex="-1" required />
                </label>
                <p class="ti-upload-methods">Haz clic, arrastra o pega tu comprobante.</p>
                <button class="ti-remove-file" type="button" data-ti-remove="receipt" hidden>Quitar comprobante</button>
                <p class="ti-upload-error" id="ti-receipt-error" data-ti-upload-error="receipt" role="alert" hidden></p>
              </section>
            </div>
            <div class="ti-submit-footer">
            <label class="ti-consent"><input name="consent" type="checkbox" required /><span>Autorizo la revisión de mi documento con Turnitin y he leído las <a href="/turnitin/#como-funciona">condiciones del servicio</a> y la <a href="/privacidad/">política de privacidad</a>.</span></label>
            <div class="ti-submit-action"><p class="ti-field-help">Recibirás ambos informes aquí cuando estén listos.</p><button class="app-button" type="submit"><span data-ti-submit-text>Enviar a revisión</span> <span aria-hidden="true">→</span></button></div>
            <p class="ti-submit-status" data-ti-submit-status role="status" aria-live="polite" hidden></p>
            </div>
          </fieldset>
        </form>
        <noscript>Activa JavaScript para enviar tu documento y consultar los informes.</noscript>
        </div>
      </details>

    </div>
    <section class="ti-panel ti-admin" data-ti-admin hidden>
      <h2>Administrar pedidos</h2>
      <p class="ti-muted">Verifica cada comprobante en Yape/Plin antes de confirmar el pago. Después carga los dos informes PDF correspondientes al documento.</p>
      <div data-ti-admin-orders></div>
    </section>
  </div>
  <TurnitinLogin />
  <TurnitinReportViewer />
  <script src="../../../scripts/turnitin.ts"></script>
</AppShell>
