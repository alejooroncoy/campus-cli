---
import Base from "../../layouts/Base.astro";
---
<Base title="Opiniones sobre Campus" description="Lo que cuentan quienes usan Campus. Lee sus opiniones y comparte la tuya." canonical="https://campuscli.com/opiniones-campus/">
<link rel="stylesheet" href="/product-reviews.css" />
<main class="campus-opinions">
<section data-campus-product-reviews id="resenas" class="product-reviews" aria-labelledby="product-reviews-title"><h1 id="product-reviews-title">Opiniones sobre Campus</h1><p>Lo que cuentan quienes usan Campus.</p><button class="opinion-button" data-opinion-open>Escribir una opinión</button></section>
<dialog class="campus-review" data-product-review aria-labelledby="opinion-dialog-title">
  <button class="opinion-close" type="button" aria-label="Cerrar" data-opinion-close>×</button>
  <h2 id="opinion-dialog-title">¿Qué te parece Campus?</h2>
  <p class="opinion-subtitle">Tu experiencia puede ayudar a otros.</p>
  <p data-review-status role="status" aria-live="polite"></p>
  <div data-review-login hidden><p>Entra para compartir tu opinión.</p><a class="opinion-button" href="/api/app/auth/start?return=%2Fopiniones-campus%2F%23compartir">Continuar con Campus</a></div>
  <button class="opinion-secondary" type="button" data-review-retry hidden>Reintentar</button>
  <form data-review-form hidden>
    <fieldset data-review-fields>
      <legend class="opinion-sr">Tu opinión sobre Campus</legend>
      <label class="opinion-label" for="review-use-case">¿Qué usaste?</label>
      <select id="review-use-case" name="useCase" required>
        <option value="" disabled selected>Elige una función</option>
        <option value="agent">Agente de Campus</option>
        <option value="chatgpt_claude">Campus en ChatGPT o Claude</option>
        <option value="professors">Buscador de profesores</option>
        <option value="library">Biblioteca</option>
        <option value="other">Otra función de Campus</option>
      </select>
      <fieldset class="opinion-rating"><legend>Tu puntuación</legend><div class="opinion-stars">
      {[1,2,3,4,5].map(n => <label><input type="radio" name="rating" value={n} required aria-label={`${n} de 5 estrellas`} /><span aria-hidden="true">★</span></label>)}
      </div></fieldset>
      <label class="opinion-label" for="review-text">Tu opinión</label>
      <textarea id="review-text" name="text" minlength="10" maxlength="1500" rows="3" placeholder="¿Qué te gustó? ¿Qué mejorarías?" required></textarea>
      <label class="opinion-label" for="review-public-name">Nombre o alias</label>
      <input id="review-public-name" name="publicName" type="text" minlength="2" maxlength="40" autocomplete="off" placeholder="Ej. Ana P." aria-describedby="opinion-name-hint" required />
      <p id="opinion-name-hint" class="opinion-name-hint">Sin insultos ni nombres de soporte. Revisamos las opiniones antes de publicarlas.</p>
      <label class="opinion-check"><input type="checkbox" name="experienced" required /><span>Mi opinión refleja mi experiencia con Campus.</span></label>
      <label class="opinion-check"><input type="checkbox" name="consent" required /><span>Publicar mi nombre, estrellas y comentario. <a href="/privacidad/#resenas-campus" target="_blank" rel="noopener">Privacidad</a></span></label>
    </fieldset>
    <div class="opinion-actions"><button class="opinion-secondary" type="button" data-review-withdraw hidden>Retirar opinión</button><button class="opinion-button" type="submit" data-review-save>Publicar opinión</button></div>
  </form>
</dialog>
<div class="opinion-toast" data-opinion-toast role="status" aria-live="polite" aria-atomic="true" hidden><span aria-hidden="true">✓</span><span data-toast-message></span><button type="button" aria-label="Cerrar aviso" data-toast-close>×</button></div>
<noscript>Activa JavaScript para escribir tu opinión.</noscript>
</main>
</Base>
<script>
  import { renderPublicProductReviews, validPublicReviews } from "../../lib/product-reviews.mjs";
  type OwnReview = { publicName: string; rating: number; text: string; useCase?: string; published: boolean; hidden: boolean };
  function initProductReview() {
    const root = document.querySelector<HTMLDialogElement>("[data-product-review]");
    if (!root || root.dataset.bound) return;
    root.dataset.bound = "true";
    const form = root.querySelector<HTMLFormElement>("[data-review-form]")!;
    const fields = root.querySelector<HTMLFieldSetElement>("[data-review-fields]")!;
    const status = root.querySelector<HTMLElement>("[data-review-status]")!;
    const login = root.querySelector<HTMLElement>("[data-review-login]")!;
    const retry = root.querySelector<HTMLButtonElement>("[data-review-retry]")!;
    const save = root.querySelector<HTMLButtonElement>("[data-review-save]")!;
    const withdraw = root.querySelector<HTMLButtonElement>("[data-review-withdraw]")!;
    const publicName = form.elements.namedItem("publicName") as HTMLInputElement;
    const useCase = form.elements.namedItem("useCase") as HTMLSelectElement;
    const text = form.elements.namedItem("text") as HTMLTextAreaElement;
    const experienced = form.elements.namedItem("experienced") as HTMLInputElement;
    const consent = form.elements.namedItem("consent") as HTMLInputElement;
    let busy = false;
    const toast = document.querySelector<HTMLElement>("[data-opinion-toast]")!;
    let toastTimer: ReturnType<typeof setTimeout>;
    const hideToast = () => { clearTimeout(toastTimer); toast.hidden = true; };
    toast.querySelector("[data-toast-close]")!.addEventListener("click", hideToast);
    function notify(message: string) {
      clearTimeout(toastTimer);
      toast.querySelector("[data-toast-message]")!.textContent = message;
      toast.hidden = false;
      toastTimer = setTimeout(hideToast, 5000);
    }
    async function refreshOpinions() {
      try {
        const page = new URL(location.href).searchParams.get("page") ?? "1";
        const response = await fetch(`/api/app/blackboard-reviews/?page=${encodeURIComponent(page)}`, {cache:"no-store", signal:AbortSignal.timeout(10000)});
        if (!response.ok) return;
        const data = await response.json();
        if (!validPublicReviews(data)) return;
        const section = document.querySelector("[data-campus-product-reviews]");
        if (section) section.outerHTML = renderPublicProductReviews(data);
      } catch { /* Keep the confirmed toast even if the public list cannot refresh. */ }
    }
    function setBusy(value: boolean) {
      busy = value; fields.disabled = value; save.disabled = value; withdraw.disabled = value;
      form.setAttribute("aria-busy", String(value));
    }
    async function request(path: string, payload?: unknown) {
      const response = await fetch(`/api/app/blackboard-review${path}/`, {
        method: payload === undefined ? "GET" : "POST", credentials: "same-origin", cache: "no-store",
        headers: payload === undefined ? {} : { "Content-Type": "application/json" },
        body: payload === undefined ? undefined : JSON.stringify(payload), signal: AbortSignal.timeout(10000),
      });
      if (response.status === 401) { form.hidden = true; login.hidden = false; throw new Error("Inicia sesión en Campus para continuar."); }
      let data;
      try { data = await response.json(); } catch { throw new Error("No pudimos cargar las opiniones. Inténtalo de nuevo."); }
      if (!response.ok) throw new Error(data.error || "No pudimos guardar la reseña. Inténtalo de nuevo.");
      return data;
    }
    function updateActions(review: OwnReview | null) {
      withdraw.hidden = !review?.published;
      save.textContent = review?.published ? "Guardar cambios" : review ? "Volver a publicar" : "Publicar opinión";
    }
    async function load() {
      retry.hidden = true;
      status.textContent = "Comprobando tu cuenta…";
      try {
        const { review } = await request("") as { review: OwnReview | null };
        if (!root!.isConnected) return;
        login.hidden = true; form.hidden = false;
        if (review) {
          publicName.value = review.publicName; text.value = review.text; useCase.value = review.useCase ?? "chatgpt_claude";
          const rating = form.querySelector<HTMLInputElement>(`input[name="rating"][value="${review.rating}"]`);
          if (rating) rating.checked = true;
          experienced.checked = true; consent.checked = review.published;
        }
        updateActions(review);
        status.textContent = review?.hidden && review.published ? "Tu opinión está pendiente de revisión."
          : review?.published ? "Puedes editar o retirar tu opinión."
          : review ? "Tu reseña está retirada y no se muestra en la página pública." : "";
      } catch (error) {
        if (!root!.isConnected) return;
        status.textContent = error instanceof Error && error.name !== "TimeoutError" ? error.message : "No pudimos comprobar tu cuenta. Inténtalo de nuevo.";
        retry.hidden = !login.hidden;
      }
    }
    retry.addEventListener("click", () => { void load(); });
    form.addEventListener("submit", async event => {
      event.preventDefault();
      if (busy || !form.reportValidity()) return;
      const payload = { useCase: useCase.value, publicName: publicName.value.trim(), rating: Number(new FormData(form).get("rating")), text: text.value.trim(), experienced: experienced.checked, consent: consent.checked };
      setBusy(true); status.textContent = "Guardando tu opinión…";
      try {
        const result = await request("", payload);
        if (!root!.isConnected) return;
        updateActions(result.review);
        status.textContent = "";
        root.close();
        notify(result.review?.hidden ? "Tu opinión está pendiente de revisión." : "Tu opinión se ha guardado.");
        void refreshOpinions();
      } catch (error) {
        status.textContent = error instanceof Error && error.name !== "TimeoutError" ? error.message : "No pudimos confirmar el guardado. Vuelve a intentar; tu texto sigue aquí.";
      } finally { setBusy(false); }
    });
    withdraw.addEventListener("click", async () => {
      if (busy) return;
      setBusy(true); status.textContent = "Retirando tu opinión…";
      try {
        await request("/withdraw", {});
        consent.checked = false; withdraw.hidden = true; save.textContent = "Volver a publicar";
        status.textContent = "";
        root.close();
        notify("Tu opinión se ha retirado.");
        void refreshOpinions();
      } catch (error) {
        status.textContent = error instanceof Error && error.name !== "TimeoutError" ? error.message : "No pudimos confirmar el retiro. Inténtalo de nuevo.";
      } finally { setBusy(false); }
    });
    const open = () => { if (!root.open) root.showModal(); void load(); };
    document.addEventListener("click", event => {
      if (event.target instanceof Element && event.target.closest("[data-opinion-open]")) open();
    });
    root.querySelector("[data-opinion-close]")!.addEventListener("click", () => root.close());
    root.addEventListener("click", event => { if (event.target === root) { const rect = root.getBoundingClientRect(); if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) root.close(); } });
    if (location.hash === "#compartir") open();
  }
  initProductReview();
  document.addEventListener("astro:page-load", initProductReview);
</script>

<style>
.opinion-toast { position:fixed; z-index:100; bottom:28px; left:50%; transform:translateX(-50%); display:flex; align-items:center; gap:12px; width:max-content; max-width:calc(100vw - 40px); box-sizing:border-box; background:#172e3b; color:white; border:1px solid #ffffff20; border-radius:12px; padding:14px 16px; box-shadow:0 8px 32px #172e3b30; font-size:14px; }
.opinion-toast[hidden] { display:none; }
.opinion-toast>span:first-child { color:#9fe4c4; }
.opinion-toast button { border:0; background:transparent; color:#c9d5dc; font-size:22px; line-height:1; cursor:pointer; padding:0 0 0 8px; }
.opinion-toast button:focus-visible { outline:2px solid white; outline-offset:4px; }

.campus-opinions { max-width: 800px; padding: 72px 24px 100px; margin: auto; min-height: 55vh; }
.campus-review { box-sizing: border-box; width: min(480px, calc(100vw - 32px)); max-height: calc(100dvh - 32px); overflow-y: auto; padding: 28px; border: 1px solid #dfe6e9; border-radius: 20px; background: #fff; color: #172b36; box-shadow: 0 24px 90px #172b3629; }
.campus-review::backdrop { background: #142b3c66; backdrop-filter: blur(3px); }
.campus-review [hidden] { display:none!important; }
.campus-review h2 { font-size: 24px; line-height: 1.25; letter-spacing:-.6px; margin:0 28px 6px 0; }
.opinion-subtitle { color:#657783; font-size:14px; margin:0 0 24px; }
.opinion-close { position:absolute; right:18px; top:14px; width:32px; height:32px; border:0; background:transparent; color:#657783; cursor:pointer; font-size:28px; }
.campus-review fieldset { border:0; margin:0; padding:0; min-width:0; }
.opinion-rating legend,.opinion-label { display:block; font-size:13px; font-weight:600; margin-bottom:8px; }
.opinion-stars { display:flex; gap:6px; margin-bottom:20px; }
.opinion-stars label { position:relative; cursor:pointer; }
.opinion-stars input { position:absolute; opacity:0; width:1px; height:1px; }
.opinion-stars span { display:block; color:#dce3e7; font-size:36px; line-height:1.25; padding:2px; transition:color .12s; }
.opinion-stars label:has(input:checked) span,.opinion-stars label:has(~ label input:checked) span { color:#eeaf32; }
.opinion-stars label:hover span { color:#d9981c; }
.opinion-stars input:focus-visible + span { outline:2px solid #176c9d; border-radius:4px; }
.campus-review select,.campus-review textarea,.campus-review input[type=text] { box-sizing:border-box; width:100%; border:1px solid #dbe3e7; border-radius:10px; background:#fff; color:inherit; padding:12px; font:inherit; font-size:14px; margin-bottom:18px; }
.campus-review textarea { resize:vertical; min-height:100px; }
.opinion-name-hint { font-size:12px; line-height:1.5; color:#657783; margin:-10px 0 16px; }
.opinion-check { display:flex; gap:8px; align-items:flex-start; margin-top:10px; font-size:12px; line-height:1.5; color:#657783; }
.opinion-check input { margin:3px 0 0; flex-shrink:0; accent-color:#176c9d; }
.opinion-check a { text-decoration:underline; text-underline-offset:2px; }
.opinion-actions { display:flex; gap:12px; justify-content:flex-end; align-items:center; margin-top:24px; }
.opinion-secondary { border:0; background:transparent; color:#657783; font:inherit; font-size:13px; cursor:pointer; padding:10px 0; }
[data-review-status] { font-size:13px; line-height:1.5; margin:12px 0; }
[data-review-status]:empty { display:none; }
.campus-review :is(input,textarea,button,a):focus-visible { outline:2px solid #176c9d; outline-offset:3px; }
.campus-review button:disabled { opacity:.5; cursor:wait; }
.opinion-sr { position:absolute; width:1px; height:1px; overflow:hidden; clip-path:inset(50%); }
@media(max-width:520px) { .campus-opinions {padding:48px 20px 72px;} .campus-review {padding:24px 20px;} }
</style>