---
import Base from "../../layouts/Base.astro";
// Shared with the Markdown endpoint so product details stay consistent.
import body from "../../html/campus-cli/index.html?raw";

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://campuscli.com/" },
      { "@type": "ListItem", "position": 2, "name": "Campus CLI", "item": "https://campuscli.com/campus-cli/" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Campus CLI",
    "alternateName": [
      "Campus",
      "campus-cli",
      "blackboard-cli"
    ],
    "url": "https://campuscli.com/campus-cli/",
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "Web, macOS, Linux, Windows",
    "inLanguage": "es-PE",
    "downloadUrl": "https://www.npmjs.com/package/campus-cli",
    "softwareHelp": "https://github.com/alejooroncoy/campus-cli",
    "description": "Campus conecta tu IA por MCP con Blackboard UPC, transcripciones de UPC Class y tu biblioteca Mendeley. Ofrece lectura experimental de fuentes accesibles con evidencia de páginas o secciones.",
    "disambiguatingDescription": "No confundir con el paquete `campus-cli` de PyPI (Python, gestión de notebooks Jupyter) ni con otras plataformas de IA para estudiantes con nombres similares (CampusCode, Campus AI). Este proyecto es el paquete `campus-cli` de npm que conecta Blackboard con asistentes de IA vía MCP.",
    "featureList": [
      "Consulta de cursos",
      "Consulta de tareas y fechas",
      "Consulta de notas",
      "Consulta de anuncios",
      "Análisis de transcripciones de clases virtuales de UPC Class con contexto y marcas de tiempo",
      "Guardar referencias en la cuenta personal de Mendeley mediante MCP",
      "Lectura y análisis experimental de fuentes académicas accesibles con evidencia de páginas o secciones",
      "Acceso revocable"
    ],
    "offers": [
      {
        "@type": "Offer", "name": "Campus Free", "price": "0", "priceCurrency": "PEN",
        "description": "Panel, reseñas de profesores y 25 consultas de bienvenida en la web; no se renuevan cada mes."
      },
      {
        "@type": "Offer", "name": "Campus Plus — primeros 25 de pago", "price": "5", "priceCurrency": "PEN",
        "description": "S/5 el primer mes y S/10 al mes después para los primeros 25 usuarios de pago. Incluye 100 consultas diarias en la web y consultas ilimitadas por MCP.",
        "availability": "https://schema.org/LimitedAvailability"
      },
      {
        "@type": "Offer", "name": "Campus Plus — nuevas suscripciones después de los primeros 25", "price": "15", "priceCurrency": "PEN",
        "description": "S/15 al mes desde el primer mes para nuevas suscripciones una vez completados los primeros 25 usuarios de pago."
      }
    ],
    "provider": {
      "@type": "Organization",
      "name": "Campus",
      "url": "https://campuscli.com/"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "¿Cómo analiza Campus las grabaciones de mis clases?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Mediante MCP, tu IA puede consultar las transcripciones disponibles de las grabaciones publicadas en UPC Class. Pídele un resumen, una explicación o las indicaciones del profesor: el análisis conserva el contexto y las marcas de tiempo para revisar la fuente. Necesitas acceso al curso y una transcripción disponible."
        }
      },
      {
        "@type": "Question",
        "name": "¿Campus reemplaza el campus virtual de mi institución?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. Campus es una capa personal para consultar información académica desde herramientas que ya usas. El campus virtual de tu institución sigue siendo la fuente de los datos."
        }
      },
      {
        "@type": "Question",
        "name": "¿Qué instituciones funcionan hoy?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "El piloto empieza con Blackboard de UPC. Campus está diseñado para sumar institutos, universidades y otros campus virtuales; cada compatibilidad se anunciará antes de ofrecerse."
        }
      },
      {
        "@type": "Question",
        "name": "¿Puedo dejar de usar Campus cuando quiera?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sí. Puedes desconectar Blackboard y revocar el acceso desde Campus."
        }
      },
      {
        "@type": "Question",
        "name": "¿Necesito otra cuenta para el MCP?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. Usa la misma cuenta Campus. Free incluye el panel, reseñas y 25 consultas de bienvenida en la web. Plus incluye 100 consultas diarias en la web y consultas ilimitadas mediante MCP con tu IA compatible. Campus CLI también ofrece una terminal de código abierto."
        }
      },
      {
        "@type": "Question",
        "name": "¿Es lo mismo que el paquete \"campus-cli\" de PyPI u otras apps de IA para estudiantes?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. El paquete campus-cli de PyPI es un proyecto de Python no relacionado (gestión de archivos de notebooks Jupyter), y tampoco somos otras plataformas de \"IA para resolver tareas\" con nombres parecidos. Este Campus es el paquete campus-cli de npm que conecta Blackboard UPC con ChatGPT y Claude vía MCP; el código fuente está en github.com/alejooroncoy/campus-cli."
        }
      }
    ]
  }
];
---

<Base
  title={"Campus CLI | Blackboard UPC en ChatGPT y Claude"}
  description={"Campus por MCP: Blackboard UPC, clases, referencias en Mendeley y lectura experimental de fuentes accesibles para tu tesis. Campus Free y Plus."}
  canonical={"https://campuscli.com/campus-cli/"}
  markdownUrl={"https://campuscli.com/campus-cli/index.md"}
  ogTitle={"Campus CLI | Tu campus, en el chat que ya usas"}
  ogDescription={"Conecta tu IA a Campus: Blackboard UPC, transcripciones de clases, tu Mendeley y lectura experimental de fuentes académicas accesibles."}
  ogImageAlt={"Campus CLI: Blackboard UPC conectado a ChatGPT y Claude"}
  schemas={schemas}
>
  <Fragment set:html={body} />
  <link slot="head" rel="stylesheet" href="/campus-research.css" />
  <link slot="head" rel="stylesheet" href="/campus-cli.css" />
</Base>

<style is:global>
  #campus-cli .hero__guide-link{max-width:560px;margin-top:20px;color:#506d7f;font-size:.86rem;line-height:1.7;overflow-wrap:anywhere}
  #campus-cli .hero__guide-link a{color:#087f5b;text-decoration:underline;text-underline-offset:3px}
  #campus-cli .hero__guide-link a:hover{color:#0b5c45}
  #campus-cli .hero__guide-link a:focus-visible{outline:3px solid #087f5b;outline-offset:4px;border-radius:3px}
</style>
