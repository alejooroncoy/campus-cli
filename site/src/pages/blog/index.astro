---
import Base from "../../layouts/Base.astro";
// Kept as raw html so the markup that is already indexed ships byte for byte.
import body from "../../html/blog/index.html?raw";
const title = "Guías para estudiantes UPC: Blackboard y matrícula | Campus";
const description = "Resuelve dudas sobre tareas, notas y profesores UPC. Encuentra guías prácticas para usar Blackboard y organizar tu ciclo con Campus.";

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Inicio",
        "item": "https://campuscli.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Blog",
        "item": "https://campuscli.com/blog/"
      }
    ]
  }
];
---

<Base
  title={title}
  description={description}
  canonical={"https://campuscli.com/blog/"}
  markdownUrl={"https://campuscli.com/blog/index.md"}
  ogTitle={title}
  ogDescription={description}
  ogImageAlt={"Blog de Campus: guías de Blackboard UPC con IA"}
  schemas={schemas}
>
  <Fragment set:html={body} />
</Base>
